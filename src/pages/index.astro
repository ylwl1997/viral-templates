---
import Layout from '../layouts/Layout.astro';
import { SITE, pathFor, keywordPath } from '../lib/site';
import { LIVE_TEMPLATES } from '../lib/templates';
import TemplateGallery from '../design/components/TemplateGallery.astro';
import ExampleCases from '../design/components/ExampleCases.astro';
import FaqSplit from '../design/components/FaqSplit.astro';
import LoopMedia from '../design/components/LoopMedia.astro';
import StepsHow from '../design/components/StepsHow.astro';
import FinalCta from '../design/components/FinalCta.astro';
import { HUB_FAQ_COMPACT } from '../lib/hubFaq';
import { localizeFaq } from '../lib/templates';

const lang = 'en' as const;
---
<Layout
  title={`${SITE.name} — a short clip from a pet photo you already have`}
  description="Choose a look, upload a pet snapshot you already have, and keep the frame vertical."
  canonicalPath="/"
  lang={lang}
>
  <section class="hero wrap hero-hub">
    <div class="hero-copy">
      <p class="eyebrow">Still frames</p>
      <h1>A short clip, held from a pet photo you already have.</h1>
      <p class="lede">
        Choose a look, upload an everyday pet snapshot, and keep the frame vertical.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={pathFor(lang, '/create/')}>Start creating</a>
        <a class="btn btn-ghost" href="#templates">Browse templates</a>
      </div>
    </div>
    <div class="hero-reel">
      {LIVE_TEMPLATES.map((t) => (
        <a class="hero-reel-item" href={keywordPath(lang, t.slug, '')}>
          <div class="media-slot">
            {t.poster || t.demoVideo ? (
              <LoopMedia poster={t.poster} video={t.demoVideo} alt="" width={180} height={320} />
            ) : (
              <div class="media-fallback"></div>
            )}
          </div>
          <span class="hero-reel-cap">{t.displayName}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap" id="examples">
    <div class="section-head">
      <h2>Examples</h2>
      <p class="sub">The pet photo that goes in, and the clip that comes out.</p>
    </div>
    <ExampleCases lang={lang} templates={LIVE_TEMPLATES} />
  </section>

  <section class="section wrap" id="templates">
    <div class="section-head">
      <h2>Templates</h2>
      <p class="sub">Open a look, or start from the studio.</p>
    </div>
    <TemplateGallery lang={lang} templates={LIVE_TEMPLATES} mode="live" />
  </section>

  <section class="section wrap" id="how">
    <div class="section-head">
      <h2>How it works</h2>
      <p class="sub">The same room, here or on a look’s own page.</p>
    </div>
    <StepsHow
      steps={[
        { title: 'Choose a look', body: 'Browse the templates and open Create.' },
        { title: 'Upload a pet', body: 'Everyday pet snapshots only. No people.' },
        { title: 'Generate', body: 'Signed-in Generate queues a job and uses the credits for that look. The clip appears on your account when it is ready. If it does not finish, the credits return.' },
      ]}
    />
  </section>

  <FaqSplit
    id="faq"
    title="Questions"
    lede="Photos, consent, and what a finished clip returns."
    cta={{ href: pathFor(lang, '/faq/'), label: 'All questions' }}
    items={localizeFaq(HUB_FAQ_COMPACT, lang)}
  />

  <FinalCta
    title="Start from a photo you already have."
    lede="Open the studio, or begin with a look."
    primary={{ href: pathFor(lang, '/create/'), label: 'Start creating' }}
    secondary={{ href: pathFor(lang, '/pricing/'), label: 'Pricing' }}
  />
</Layout>
