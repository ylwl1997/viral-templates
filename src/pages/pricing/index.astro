---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../lib/site';
import PricingGrid from '../../design/components/PricingGrid.astro';

const { packs, oneShotUsd, kissCamOneShotUsd } = SITE.pricing;
---
<Layout
  title="Pricing"
  description="Demo pricing for Viral Templates AI video products."
  canonicalPath="/pricing/"
  lang="en"
>
  <div class="page-head wrap"><h1>Pricing</h1><p>Demo figures — checkout opens when payments are ready.</p></div>
  <section class="section wrap">
    <PricingGrid
      oneShotLabel="One-shot"
      oneShotUsd={oneShotUsd}
      oneShotMeta={`Kiss Cam from $${kissCamOneShotUsd} · Demo`}
      packs={packs}
      note="Pay on Create shows Coming soon until checkout is ready."
    />
  </section>
</Layout>
