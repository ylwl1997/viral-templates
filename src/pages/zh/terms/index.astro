---
import Layout from '../../../layouts/Layout.astro';
import { SITE } from '../../../lib/site';
const lang = 'zh' as const;
---
<Layout
  title={`服务条款 — ${SITE.name}`}
  description="摘要页；完整以英文为准。"
  canonicalPath="/terms/"
  lang={lang}
>
  <div class="page-head wrap">
    <h1>服务条款</h1>
    <p>摘要页；完整以英文为准。</p>
  </div>

  <article class="section wrap prose">
    <p>完整条款以 <a href="/terms/">英文 Terms</a> 为准。摘要：仅限成人同意；非官方；Kiss Cam 无演唱会素材；禁止绑风扇；失败退积分；照片约 30 天删除。</p>
  </article>
</Layout>
