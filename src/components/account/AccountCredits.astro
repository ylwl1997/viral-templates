---
import { SITE, packPriceList, type Lang } from '../../lib/site';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const packLine = packPriceList(lang);
---

<div data-account-panel="credits" data-lang={lang}>
  <header class="account-page-head">
    <h1>{zh ? '积分' : 'Credits'}</h1>
    <p>
      {
        zh
          ? '1 积分大约是短片的 1 秒。新账户从 0 开始。短片没完成，积分会退回。'
          : 'One credit is about one second of a clip. A new account starts at 0. A clip that does not finish returns its credits.'
      }
    </p>
  </header>

  <p class="account-alert" data-account-alert hidden role="status">
    <span data-alert-text></span>
    <button type="button" class="btn btn-ghost btn-sm" data-retry hidden>Try again</button>
  </p>
  <p class="account-alert" data-checkout-note hidden role="status"></p>

  <div class="card account-stat" style="margin-bottom:1.25rem">
    <p class="account-stat-label">{zh ? '当前余额' : 'Current balance'}</p>
    <p class="account-stat-value" data-balance>—</p>
    <p class="account-stat-meta">
      {zh ? '每个效果按素材时长计费，每秒 1 积分。' : 'Each look charges one credit per second of its source clip.'}
    </p>
  </div>

  <section class="account-block">
    <div class="account-block-head">
      <h2>{zh ? '流水' : 'Ledger'}</h2>
    </div>
    <p class="account-loading" data-loading>{zh ? '加载中…' : 'Loading…'}</p>
    <div class="empty-state" data-empty hidden>
      <h3>{zh ? '还没有流水' : 'No ledger entries yet'}</h3>
      <p>
        {
          zh
            ? '充值、扣费和退还会列在这里。'
            : 'Top-ups, deductions, and refunds are listed here.'
        }
      </p>
    </div>
    <ul class="ledger-list" data-list hidden></ul>
  </section>

  <section class="account-block" data-packs>
    <div class="account-block-head">
      <h2>{zh ? '购买积分' : 'Buy credits'}</h2>
    </div>
    <div class="card callout info" data-pack-note>
      <strong>{zh ? '结账未开放。' : 'Checkout is not open.'}</strong>
      {' '}
      {
        zh
          ? `套餐：${packLine}。现在不会扣款。`
          : `Packs: ${packLine}. Nothing is charged now.`
      }
    </div>
    <div class="pack-row">
      {
        SITE.pricing.packs.map((p) => (
          <button type="button" class="btn btn-line pack-btn" data-pack={p.id} disabled aria-disabled="true">
            <span data-pack-label>{zh ? p.labelZh : p.label} · {p.credits} {zh ? '积分' : 'credits'}</span>
          </button>
        ))
      }
    </div>
  </section>

  <section class="account-block">
    <div class="account-block-head">
      <h2>{zh ? '有问题' : 'Something off'}</h2>
    </div>
    <form class="support-note" data-support>
      <p>
        {
          zh
            ? '如果付款后积分没有到账，或失败的短片没有退回积分，写一条说明。我们按账户里的邮箱查看。'
            : 'If a purchase did not add credits, or a failed clip did not return them, leave a note. We read it from the email on this account.'
        }
      </p>
      <textarea name="message" rows="3" maxlength="400" required placeholder={zh ? '发生了什么' : 'What happened'}></textarea>
      <button type="submit" class="btn btn-line">{zh ? '发送说明' : 'Send note'}</button>
      <p data-support-status hidden></p>
    </form>
  </section>
</div>
