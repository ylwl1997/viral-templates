---
import AccountShell from '../../../../../../components/account/AccountShell.astro';
import AccountCreations from '../../../../../../components/account/AccountCreations.astro';
import { keywordPath } from '../../../../../../lib/site';
import { TEMPLATES, type Template } from '../../../../../../lib/templates';

export function getStaticPaths() {
  return TEMPLATES.map((template) => ({
    params: { slug: template.slug },
    props: { template },
  }));
}

interface Props { template: Template }
const { template: t } = Astro.props;
const lang = 'zh' as const;
---
<AccountShell
  lang={lang}
  template={t}
  active="creations"
  title={`作品 · ${t.displayNameZh}`}
  description={`保存在你的 ${t.displayNameZh} 账户中的作品。`}
>
  <AccountCreations lang={lang} createHref={keywordPath(lang, t.slug, 'create')} />
</AccountShell>
