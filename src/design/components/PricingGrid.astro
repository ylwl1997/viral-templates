---
interface Pack {
  label: string;
  credits: number;
  usd: number;
  popular?: boolean;
}

interface Props {
  oneShotLabel: string;
  oneShotUsd: number;
  oneShotMeta: string;
  packs: readonly Pack[];
  note?: string;
  /** @deprecated use note */
  stubNote?: string;
  popularLabel?: string;
}

const { oneShotLabel, oneShotUsd, oneShotMeta, packs, note, stubNote, popularLabel = 'Popular' } = Astro.props;
const footerNote = note || stubNote;
---
<div class="pricing-grid">
  <div class="price-card">
    <h3>{oneShotLabel}</h3>
    <p class="amount">${oneShotUsd}</p>
    <p class="meta">{oneShotMeta}</p>
  </div>
  {packs.map((p) => (
    <div class:list={['price-card', p.popular && 'popular']}>
      <h3>
        {p.label}
        {p.popular && <span class="popular-tag">{popularLabel}</span>}
      </h3>
      <p class="amount">${p.usd}</p>
      <p class="meta">{p.credits} credits · Demo</p>
    </div>
  ))}
</div>
{footerNote && <p style="margin-top:1rem;color:var(--muted);font-size:0.9rem;">{footerNote}</p>}
