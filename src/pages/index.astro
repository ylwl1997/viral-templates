---
import Layout from '../layouts/Layout.astro';
import { SITE, keywordPath } from '../lib/site';
import { LIVE_TEMPLATES, SOON_TEMPLATES } from '../lib/templates';
---
<Layout
  title={`${SITE.name} — keyword directory`}
  description="Light directory of one-keyword AI video sites. Each live keyword has its own subdomain shell (path fallback /t/{slug}/)."
  canonicalPath="/"
  lang="en"
>
  <section class="hero wrap">
    <div class="eyebrow">一词一子域 · directory</div>
    <h1>Keyword sites. <span class="grad">One slug each.</span></h1>
    <p class="lede">
      {SITE.taglineEn}. Apex is a light index only — each live keyword is its own site under
      <code>{`{slug}.${SITE.apex}`}</code> (preview via <code>/t/{`{slug}`}/</code>).
    </p>
  </section>

  <section class="section wrap" id="live">
    <h2>Live</h2>
    <p class="sub">Independent single-site shells. Open a keyword to create.</p>
    <div class="dir-list">
      {LIVE_TEMPLATES.map((t) => (
        <a class="dir-row" href={keywordPath('en', t.slug, '')}>
          <span class:list={['dir-swatch', t.accent]} aria-hidden="true" />
          <span class="dir-main">
            <strong>{t.displayName}</strong>
            <span class="dir-meta">{t.taglineEn}</span>
          </span>
          <span class="badge">{t.photoCount} photo{t.photoCount === 2 ? 's' : ''} · live</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap" id="soon">
    <h2>Coming soon</h2>
    <p class="sub">Reserved shells — not generatable yet.</p>
    <div class="dir-list">
      {SOON_TEMPLATES.map((t) => (
        <a class="dir-row soon" href={keywordPath('en', t.slug, '')}>
          <span class:list={['dir-swatch', t.accent]} aria-hidden="true" />
          <span class="dir-main">
            <strong>{t.displayName}</strong>
            <span class="dir-meta">{t.taglineEn}</span>
          </span>
          <span class="badge">soon</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
