---
import type { Lang } from '../../lib/site';
import { pathFor } from '../../lib/site';
import { accountHref } from '../../lib/auth';
import type { Template } from '../../lib/templates';

interface Props {
  lang?: Lang;
  active: 'overview' | 'creations' | 'credits' | 'settings';
  template?: Template;
}

const { lang = 'en', active, template } = Astro.props;
const label = (en: string, zh: string) => (lang === 'zh' ? zh : en);
const nav = [
  { id: 'overview' as const, href: accountHref(lang, ''), en: 'Overview', zh: '概览' },
  { id: 'creations' as const, href: accountHref(lang, 'creations'), en: 'Creations', zh: '作品' },
  { id: 'credits' as const, href: accountHref(lang, 'credits'), en: 'Credits', zh: '积分' },
  { id: 'settings' as const, href: accountHref(lang, 'settings'), en: 'Settings', zh: '设置' },
];
const createHref = template
  ? (lang === 'zh' ? `/zh/t/${template.slug}/create/` : `/t/${template.slug}/create/`)
  : pathFor(lang, '/create/');
---
<div class="account-shell wrap is-logged-out" data-account-shell data-lang={lang} data-active={active}>
  <aside class="account-sidebar" data-account-sidebar aria-label={label('Account', '账户')} hidden>
    <div class="account-sidebar-head">
      <p class="account-kicker">{label('Account', '账户')}</p>
      <a class="btn btn-ghost btn-sm account-new-create" href={createHref}>
        {label('New create', '新建创作')}
      </a>
    </div>
    <nav class="account-nav">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['account-nav-link', active === item.id && 'is-on']}
          aria-current={active === item.id ? 'page' : undefined}
        >
          {label(item.en, item.zh)}
        </a>
      ))}
    </nav>
    <p class="account-sidebar-note">
      {label('Creations and credits are saved with your account.', '作品和积分保存在你的账户中。')}
    </p>
  </aside>
  <div class="account-main">
    <div class="account-gate" data-account-gate>
      <div class="card account-gate-card">
        <h1>{label('Sign in to view your account', '登录后查看账户')}</h1>
        <p>
          {label(
            'Your creations, credits, and settings appear here after you sign in.',
            '登录后可在此查看作品、积分与设置。'
          )}
        </p>
        <a class="btn btn-primary" data-account-gate-signin href={accountHref(lang, 'sign-in')}>
          {label('Sign in', '登录')}
        </a>
      </div>
    </div>
    <div class="account-body" data-account-body hidden>
      <slot />
    </div>
  </div>
</div>
<script is:inline src="/scripts/account-shell.js" defer></script>
<script is:inline src="/scripts/account-data.js" defer></script>
