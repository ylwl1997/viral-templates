---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../lib/site';
import { LIVE_TEMPLATES } from '../../lib/templates';
import PricingGrid from '../../design/components/PricingGrid.astro';

const { packs } = SITE.pricing;
const costs = LIVE_TEMPLATES.map((t) => t.creditCost ?? 0).filter((n) => n > 0);
const low = Math.min(...costs);
const high = Math.max(...costs);
const clipCredits = low === high ? String(low) : `${low}–${high}`;
---
<Layout
  title={`Pricing · ${SITE.name}`}
  description="One credit is about one second. Starter $5.99, Mid $14.99, Large $39.99."
  canonicalPath="/pricing/"
  lang="en"
>
  <div class="page-head wrap">
    <h1>Pricing</h1>
    <p>One credit is about one second of a clip. Pack prices are listed here. This page does not charge a card.</p>
  </div>
  <section class="section wrap">
    <PricingGrid
      oneShotLabel="A clip"
      oneShotAmount={clipCredits}
      oneShotMeta="credits · one per second of the source"
      packs={packs}
      packMeta="credits"
      creditUnit="credits"
      note="A clip costs one credit per second of that look’s source, rounded to the nearest second. A clip that does not finish returns those credits. Buy a pack from your account."
    />
  </section>
</Layout>
