---
import AccountShell from '../../../components/account/AccountShell.astro';
import AccountOverview from '../../../components/account/AccountOverview.astro';
import { accountHref } from '../../../lib/auth';
import { pathFor } from '../../../lib/site';

const lang = 'zh' as const;
---
<AccountShell
  lang={lang}
  active="overview"
  title="账户 · Viral Templates"
  description="Viral Templates 账户概览 — 余额与最近作品。"
>
  <AccountOverview
    lang={lang}
    createHref={pathFor(lang, '/create/')}
    creationsHref={accountHref(lang, 'creations')}
    creditsHref={accountHref(lang, 'credits')}
  />
</AccountShell>
