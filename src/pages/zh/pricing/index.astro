---
import Layout from '../../../layouts/Layout.astro';
import { SITE } from '../../../lib/site';
import PricingGrid from '../../../design/components/PricingGrid.astro';

const { packs, oneShotUsd, kissCamOneShotUsd } = SITE.pricing;
---
<Layout
  title="价格（占位）"
  description="Viral Templates AI 视频产品占位价格。"
  canonicalPath="/pricing/"
  lang="zh"
>
  <div class="page-head wrap"><h1>价格（占位）</h1><p>结账未接通。数字仅为占位。</p></div>
  <section class="section wrap">
    <PricingGrid
      oneShotLabel="单次"
      oneShotUsd={oneShotUsd}
      oneShotMeta={`Kiss Cam 起 $${kissCamOneShotUsd} · 占位`}
      packs={packs}
      stubNote="创作页支付为明确占位 — 不会伪造成功。"
    />
  </section>
</Layout>
