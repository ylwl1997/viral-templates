---
import Layout from '../../layouts/Layout.astro';
import { SITE, pathFor, keywordPath } from '../../lib/site';
import { LIVE_TEMPLATES } from '../../lib/templates';
import TemplateGallery from '../../design/components/TemplateGallery.astro';
import LoopMedia from '../../design/components/LoopMedia.astro';
import StepsHow from '../../design/components/StepsHow.astro';
import FinalCta from '../../design/components/FinalCta.astro';

const lang = 'zh' as const;
---
<Layout
  title={`${SITE.name} — 用已有照片做竖屏短片`}
  description="选一个风格，上传照片，做成竖屏短片。需成人同意。"
  canonicalPath="/"
  lang={lang}
>
  <section class="hero wrap hero-hub">
    <div class="hero-copy">
      <p class="eyebrow">模板</p>
      <h1>用已有的照片，做一条竖屏短片。</h1>
      <p class="lede">
        选一个风格，上传照片，画面保持竖屏。需成人同意。
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={pathFor(lang, '/create/')}>开始制作</a>
        <a class="btn btn-ghost" href="#templates">浏览模板</a>
      </div>
    </div>
    <div class="hero-reel">
      {LIVE_TEMPLATES.map((t) => (
        <a class="hero-reel-item" href={keywordPath(lang, t.slug, '')}>
          <div class="media-slot">
            {t.poster || t.demoVideo ? (
              <LoopMedia poster={t.poster} video={t.demoVideo} alt="" width={180} height={320} />
            ) : (
              <div class="media-fallback"></div>
            )}
          </div>
          <span class="hero-reel-cap">{t.displayNameZh}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap" id="templates">
    <div class="section-head">
      <h2>模板</h2>
      <p class="sub">打开一个风格，或从工作室开始。</p>
    </div>
    <TemplateGallery lang={lang} templates={LIVE_TEMPLATES} mode="live" />
  </section>

  <section class="section wrap" id="how">
    <div class="section-head">
      <h2>如何使用</h2>
      <p class="sub">主站和每个风格页面用的是同一套工作室。</p>
    </div>
    <StepsHow
      steps={[
        { title: '选择风格', body: '浏览模板并打开创作。' },
        { title: '上传与授权', body: '仅限成人同意照片。禁止未成年人。' },
        { title: '生成', body: '登录后生成会把任务排进你的账户，并扣一次积分。目前还没有成片。' },
      ]}
    />
  </section>

  <FinalCta
    title="准备好了再开始。"
    lede="打开工作室，或从喜欢的风格进入。"
    primary={{ href: pathFor(lang, '/create/'), label: '开始制作' }}
    secondary={{ href: pathFor(lang, '/pricing/'), label: '价格' }}
  />
</Layout>
