---
import Layout from '../../../layouts/Layout.astro';
import { SITE, pathFor, getTemplate } from '../../../lib/site';
const lang = 'en' as const;
const t = getTemplate('kiss-cam');
const price = SITE.pricing.kissCamOneShotUsd;
---
<Layout
  title={`Create ${t.nameEn} — ${SITE.name}`}
  description="Upload two photos, confirm adult consent, spend credits, generate a stadium kiss-cam style AI clip. No real concert footage."
  canonicalPath="/create/kiss-cam/"
  lang={lang}
>
  <div class="page-head wrap">
    <h1>Create — {t.nameEn}</h1>
    <p>Two photos → {t.durationEn} stadium-style AI remix. Demo UI works without a fal key.</p>
  </div>

  <section class="section wrap">
    <div class="callout warn">
      <strong>Adult consent · no concert footage.</strong> Subjects must be adults (18+) or pets with permission.
      Fan-made AI remix — not affiliated with Coldplay, CapCut, or any venue. No official concert footage is used.
    </div>

    <div class="studio">
      <div class="card" style="padding:1.35rem">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;flex-wrap:wrap;">
          <h2 style="margin:0;font-size:1.15rem;">Upload 2 photos</h2>
          <span class="badge">Demo mode — configure FAL</span>
        </div>
        <p style="color:var(--muted);font-size:0.9rem;margin:0.65rem 0 0;">
          JPG/PNG/WebP · max ~10MB each · people or pets · no minors
        </p>
        <div class="upload-slots">
          <label class="slot" id="slot-a">
            <input type="file" accept="image/jpeg,image/png,image/webp" id="file-a" />
            <span class="slot-label">Photo A<br /><small>Person / pet 1</small></span>
          </label>
          <label class="slot" id="slot-b">
            <input type="file" accept="image/jpeg,image/png,image/webp" id="file-b" />
            <span class="slot-label">Photo B<br /><small>Person / pet 2</small></span>
          </label>
        </div>
        <label style="display:flex;gap:0.5rem;align-items:flex-start;margin:0.5rem 0 1rem;font-size:0.92rem;color:var(--secondary)">
          <input type="checkbox" id="consent" style="margin-top:0.25rem" />
          <span>
            I confirm both subjects are adults (18+) or pets, I have permission to use these photos,
            and I understand this is an AI remix — not official Coldplay / CapCut / concert footage.
          </span>
        </label>
        <button type="button" class="btn btn-primary" id="generate-btn" style="width:100%;" disabled>
          Generate · 1 credit (${price})
        </button>
        <div class="status-box cfg" id="status">Select two photos and accept consent to enable Generate.</div>
      </div>

      <aside class="card">
        <h3>Credits &amp; price</h3>
        <p style="margin:0.5rem 0"><span style="color:var(--muted)">One-shot</span><br /><strong style="font-size:1.4rem">${price}</strong></p>
        <p style="margin:0.5rem 0"><span style="color:var(--muted)">This run</span><br /><strong>1 credit</strong></p>
        <p style="margin:0.5rem 0"><span style="color:var(--muted)">Clip length</span><br /><strong>{t.durationEn}</strong></p>
        <p style="margin:0.5rem 0"><span style="color:var(--muted)">Photo retention</span><br /><strong>~{SITE.photoRetentionDays} days</strong></p>
        <div class="callout info" style="margin-top:1rem;margin-bottom:0">
          <strong>Configure FAL to render.</strong> Set <code>FAL_KEY</code> (or <code>FAL_API_KEY</code>) + <code>FAL_MODEL</code> in Cloudflare Pages.
          Until then, Generate simulates a queued job.
        </div>
        <p style="font-size:0.85rem;color:var(--muted);margin:0.85rem 0 0;">
          Need packs? <a href={pathFor(lang, '/pricing/')}>Pricing</a> · Waffo stub until <code>WAFFO_*</code>.
          · <a href={pathFor(lang, '/')}>← All templates</a>
        </p>
      </aside>
    </div>
  </section>

  <script is:inline>
    (function () {
      const a = document.getElementById('file-a');
      const b = document.getElementById('file-b');
      const slotA = document.getElementById('slot-a');
      const slotB = document.getElementById('slot-b');
      const consent = document.getElementById('consent');
      const btn = document.getElementById('generate-btn');
      const status = document.getElementById('status');
      let hasA = false, hasB = false;
      function setStatus(text, kind) {
        status.textContent = text;
        status.className = 'status-box' + (kind ? ' ' + kind : '');
      }
      function refresh() {
        btn.disabled = !(hasA && hasB && consent.checked);
      }
      function bind(input, slot, which) {
        input.addEventListener('change', function () {
          const file = input.files && input.files[0];
          if (!file) return;
          if (which === 'a') hasA = true; else hasB = true;
          const url = URL.createObjectURL(file);
          slot.style.backgroundImage = 'url(' + url + ')';
          slot.classList.add('has-file');
          setStatus('Photos updating… check consent, then Generate.\nFAL demo mode.', 'cfg');
          refresh();
        });
      }
      bind(a, slotA, 'a');
      bind(b, slotB, 'b');
      consent.addEventListener('change', refresh);
      btn.addEventListener('click', function () {
        if (!(hasA && hasB)) { setStatus('Upload two photos.', 'err'); return; }
        if (!consent.checked) { setStatus('Confirm consent.', 'err'); return; }
        setStatus('Demo queue… job_demo_kisscam_' + Date.now() + '\nNo concert footage used. FAL stub.', 'cfg');
        setTimeout(function () {
          setStatus('Demo complete. Wire FAL_* for real ~11–12s renders.\nFailed jobs refund the credit.', 'ok');
        }, 1800);
      });
    })();
  </script>
</Layout>
