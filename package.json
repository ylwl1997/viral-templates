{
  "name": "viral-templates",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "pages:dev": "astro build && wrangler pages dev dist --port 8788",
    "test:account": "node --experimental-sqlite scripts/account-d1.test.mjs",
    "test:auth": "node --experimental-sqlite scripts/google-auth.test.mjs",
    "test:media": "node --experimental-sqlite scripts/r2-media.test.mjs && node scripts/media-finish.test.mjs",
    "test:payments": "node --experimental-sqlite scripts/checkout-webhook.test.mjs",
    "test:bailian": "node --experimental-sqlite scripts/bailian-worker.test.mjs",
    "test:agnes": "node --experimental-sqlite scripts/agnes-video.test.mjs",
    "smoke:bailian": "node scripts/smoke-bailian.mjs",
    "job-drain:deploy": "wrangler deploy --config workers/job-drain/wrangler.toml",
    "d1:migrate:local": "wrangler d1 migrations apply viral-templates --local",
    "astro": "astro",
    "deploy": "astro build && wrangler pages deploy dist --project-name=viral-templates"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@waffo/pancake-ts": "0.28.0",
    "astro": "^5.14.0"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "sharp@0.35.5": true,
    "workerd@1.20261019.1": true
  }
}
