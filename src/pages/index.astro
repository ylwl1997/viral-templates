---
import Layout from '../layouts/Layout.astro';
import { SITE, pathFor } from '../lib/site';
import { LIVE_TEMPLATES, SOON_TEMPLATES } from '../lib/templates';
import TemplateGallery from '../design/components/TemplateGallery.astro';
import StepsHow from '../design/components/StepsHow.astro';
import FinalCta from '../design/components/FinalCta.astro';

const lang = 'en' as const;
---
<Layout
  title={`${SITE.name} — AI viral video templates`}
  description="Choose a trending AI look, upload a photo, and create a short vertical clip. Adult consent required."
  canonicalPath="/"
  lang={lang}
>
  <section class="hero wrap hero-preset-centered">
    <div class="eyebrow">Trending looks</div>
    <h1>AI viral video <span class="grad">templates</span></h1>
    <p class="lede">
      Pick a look, upload a photo, get a vertical clip. Adult consent required.
    </p>
    <div class="hero-cta">
      <a class="btn btn-primary" href={pathFor(lang, '/create/')}>Start creating</a>
      <a class="btn btn-ghost" href="#templates">Browse templates</a>
    </div>
  </section>

  <section class="section wrap" id="templates">
    <div class="section-head">
      <h2>Templates</h2>
      <p class="sub">Live looks you can open and create with.</p>
    </div>
    <TemplateGallery lang={lang} templates={LIVE_TEMPLATES} mode="live" />
  </section>

  <section class="section wrap" id="soon">
    <div class="section-head">
      <h2>Coming soon</h2>
      <p class="sub">More looks in the pipeline — open a brand page to follow along.</p>
    </div>
    <TemplateGallery lang={lang} templates={SOON_TEMPLATES} mode="soon" />
  </section>

  <section class="section wrap" id="how">
    <div class="section-head">
      <h2>How it works</h2>
      <p class="sub">Same studio flow on the hub or on any live template page.</p>
    </div>
    <StepsHow
      steps={[
        { title: 'Choose a template', body: 'Browse trending looks and open Create.' },
        { title: 'Upload & consent', body: 'Adult-consent photos only. No minors.' },
        { title: 'Generate', body: 'Create opens when generation is ready. Until then the button shows Coming soon.' },
      ]}
    />
  </section>

  <FinalCta
    title="Ready to create?"
    lede="Open the hub studio or jump into a live brand page."
    primary={{ href: pathFor(lang, '/create/'), label: 'Start creating' }}
    secondary={{ href: pathFor(lang, '/pricing/'), label: 'Pricing' }}
  />
</Layout>
