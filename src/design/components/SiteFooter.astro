---
import { SITE, type Lang } from '../../lib/site';
import Wordmark from './Wordmark.astro';

export type FooterCol = { title: string; links: { href: string; label: string }[] };

interface Props {
  lang: Lang;
  brandName: string;
  tagline: string;
  disclaimer: string;
  columns: FooterCol[];
  brandFooter?: boolean;
  /** Hub lockup. Brand footers keep their own name, plus a quiet parent line. */
  wordmark?: 'plain' | 'split';
}

const { brandName, tagline, disclaimer, columns, brandFooter, wordmark = 'plain' } = Astro.props;
---
<footer class="site-footer">
  <div class:list={['wrap', 'footer-grid', brandFooter && 'kw-footer']}>
    <div>
      <h3>{wordmark === 'split' ? <Wordmark /> : brandName}</h3>
      <p>{tagline}</p>
      {brandFooter && <p class="parent-brand">{SITE.name}</p>}
    </div>
    {columns.map((col) => (
      <div>
        <h3>{col.title}</h3>
        {col.links.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
      </div>
    ))}
  </div>
  <div class="wrap disclaimer">{disclaimer}</div>
</footer>
