---
import '../styles/global.css';
import { SITE, type Lang, keywordPath, pathFor } from '../lib/site';
import SiteHeader from '../design/components/SiteHeader.astro';
import SiteFooter from '../design/components/SiteFooter.astro';
import type { Template } from '../lib/templates';

interface Props {
  template: Template;
  title: string;
  description: string;
  /** Page key: '' | 'create' | account subpath e.g. 'account' | 'account/sign-in' */
  page?: '' | 'create' | 'account' | 'account/sign-in' | 'account/creations' | 'account/credits' | 'account/settings';
  lang?: Lang;
}

const { template: t, title, description, page = '', lang = 'en' } = Astro.props;
const label = (en: string, zh: string) => (lang === 'zh' ? zh : en);
const home = keywordPath(lang, t.slug, '');
const createHref = keywordPath(lang, t.slug, 'create');
const canonicalPath =
  page === 'create'
    ? `/t/${t.slug}/create/`
    : page && String(page).startsWith('account')
      ? `/t/${t.slug}/${page}/`
      : `/t/${t.slug}/`;
const pagePath = lang === 'zh' ? `/zh${canonicalPath}` : canonicalPath;
const canonical = `${SITE.url}${pagePath}`;
const enUrl = `${SITE.url}${canonicalPath}`;
const zhUrl = `${SITE.url}/zh${canonicalPath}`;
const htmlLang = lang === 'zh' ? 'zh-CN' : 'en';
const name = lang === 'zh' ? t.displayNameZh : t.displayName;
const isLive = t.status === 'live';
const ga4 = SITE.ga4Id;
const theme = t.theme;

const nav = [
  { href: `${home}#how`, label: label('How it works', '如何使用') },
  isLive
    ? { href: createHref, label: label('Create', '创作'), current: page === 'create' }
    : { href: '#', label: label('Coming soon', '即将上线'), muted: true },
  { href: `${home}#pricing`, label: label('Pricing', '价格') },
  { href: pathFor(lang, '/faq/'), label: 'FAQ' },
];

const footerCols = [
  {
    title: label('Product', '产品'),
    links: [
      { href: `${home}#how`, label: label('How it works', '如何使用') },
      ...(isLive ? [{ href: createHref, label: label('Create', '创作') }] : []),
      { href: `${home}#pricing`, label: label('Pricing', '价格') },
      { href: pathFor(lang, '/faq/'), label: 'FAQ' },
    ],
  },
  {
    title: label('Legal', '法律'),
    links: [
      { href: pathFor(lang, '/terms/'), label: label('Terms', '服务条款') },
      { href: pathFor(lang, '/privacy/'), label: label('Privacy', '隐私政策') },
    ],
  },
];
---
<!doctype html>
<html lang={htmlLang} data-accent={theme.accent} data-theme={t.slug}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#070b14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {ga4 && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
        <script is:inline define:vars={{ ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4);
        </script>
      </>
    )}
  </head>
  <body
    class={`kw-site accent-${theme.accent}`}
    data-shell="brand"
    data-theme={t.slug}
    data-accent={theme.accent}
    data-hero={theme.heroPreset}
    data-voice={theme.typeVoice}
    data-card={theme.cardStyle}
    data-cover={theme.coverStyle}
    data-ambience={theme.ambience}
  >
    <SiteHeader
      lang={lang}
      homeHref={home}
      logoSrc={t.logo}
      brandName={name}
      nav={nav}
      canonicalPath={canonicalPath}
      enHref={keywordPath('en', t.slug, page)}
      zhHref={keywordPath('zh', t.slug, page)}
      cta={
        isLive
          ? { href: createHref, label: label('Create', '开始创作') }
          : { disabled: true, label: label('Soon', '即将上线') }
      }
      nextPath={Astro.url.pathname + (Astro.url.search || '')}
    />
    <main>
      <slot />
    </main>
    <SiteFooter
      lang={lang}
      brandName={name}
      tagline={label(t.taglineEn, t.taglineZh)}
      disclaimer={label(t.disclaimerEn, t.disclaimerZh)}
      columns={footerCols}
      brandFooter
    />
    <script is:inline src="/scripts/header-auth.js" defer></script>
  </body>
</html>
