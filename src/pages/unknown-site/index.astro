---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../lib/site';
---
<Layout
  title={`Template not found — ${SITE.name}`}
  description="This template page could not be found."
  canonicalPath="/unknown-site/"
  lang="en"
>
  <section class="hero wrap">
    <div class="eyebrow">404</div>
    <h1>Template not found</h1>
    <p class="lede">
      We couldn’t find that experience. Double-check the link, or head back home.
    </p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="/">Home</a>
    </div>
  </section>
</Layout>
