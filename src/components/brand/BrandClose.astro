---
import FaqSplit from '../../design/components/FaqSplit.astro';
import FinalCta from '../../design/components/FinalCta.astro';
import PricingGrid from '../../design/components/PricingGrid.astro';
import StepsHow from '../../design/components/StepsHow.astro';
import { SITE, keywordPath, type Lang } from '../../lib/site';
import { localizeFaq, type Template } from '../../lib/templates';

interface Props {
  template: Template;
  lang: Lang;
  howLede: string;
  faqLede: string;
}

const { template: t, lang, howLede, faqLede } = Astro.props;
const L = (en: string, zh: string) => (lang === 'zh' ? zh : en);
const createHref = keywordPath(lang, t.slug, 'create');
const { packs } = SITE.pricing;
const oneShot = t.creditCost || 0;
const steps = (lang === 'zh' ? t.howZh : t.howEn).map((step, i) => ({
  title: L(`Step ${i + 1}`, `步骤 ${i + 1}`),
  body: step,
}));
const name = lang === 'zh' ? t.displayNameZh : t.displayName;
---
<section class="section wrap" id="how">
  <h2>{L('How it works', '如何使用')}</h2>
  <p class="sub">{howLede}</p>
  <StepsHow steps={steps} />
</section>

<section class="section wrap" id="pricing">
  <h2>{L('Pricing', '价格')}</h2>
  <p class="sub">{L('One credit is about one second. Pack prices are listed below.', '1 积分大约 1 秒。套餐价格列在下面。')}</p>
  <PricingGrid
    oneShotLabel={L('This look', '这个效果')}
    oneShotAmount={String(oneShot)}
    oneShotMeta={L('credits · about one per second', '积分 · 大约每秒 1 积分')}
    packs={packs}
    packMeta={L('credits', '积分')}
    creditUnit={L('credits', '积分')}
    popularLabel={L('Popular', '热门')}
    note={L(
      'Signed-in Generate uses these credits. If the clip does not finish, they return. Buy a pack from your account.',
      '登录后生成会扣这些积分。短片没完成会退回。在账户里购买套餐。',
    )}
  />
</section>

<FaqSplit
  id="faq"
  title={L('Questions', '常见问题')}
  lede={faqLede}
  items={localizeFaq(t.faq, lang)}
  cta={{ href: createHref, label: L('Create', '创作') }}
/>

<FinalCta
  title={L(`Create with ${name}`, `用 ${name} 创作`)}
  lede={L(
    'Upload and confirm consent, then generate. The clip appears on your account when it is ready.',
    '上传并确认授权后再生成。成片会在完成后出现在你的账户里。',
  )}
  primary={{ href: createHref, label: L('Create', '创作') }}
  secondary={{ href: '#pricing', label: L('Pricing', '价格') }}
/>
