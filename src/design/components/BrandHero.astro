---
import type { HeroPreset } from '../../lib/templates';

interface Props {
  preset: HeroPreset;
  eyebrow?: string;
  eyebrowLogo?: string;
  title: string;
  lede: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  rail?: string[];
  logo?: string;
  /** 9:16 still or loop poster for Live brands */
  mediaSrc?: string;
  mediaAlt?: string;
  soon?: boolean;
}

const {
  preset,
  eyebrow,
  eyebrowLogo,
  title,
  lede,
  primaryCta,
  secondaryCta,
  rail,
  logo,
  mediaSrc,
  mediaAlt = '',
  soon,
} = Astro.props;

const showMedia = !soon && !!(mediaSrc || logo);
---
<section class:list={['hero', 'wrap', `hero-preset-${preset}`, soon && 'soon-hero', showMedia && 'hero-has-media']}>
  {showMedia && (
    <div class="hero-media" aria-hidden={mediaAlt ? undefined : 'true'}>
      <div class="media-slot media-slot-hero">
        {mediaSrc ? (
          <img class="media-poster" src={mediaSrc} alt={mediaAlt} width="360" height="640" />
        ) : (
          <div class="media-fallback">
            {logo && <img src={logo} width="72" height="72" alt="" />}
            <span class="media-loop" aria-hidden="true"></span>
          </div>
        )}
        <span class="media-badge">9:16</span>
      </div>
    </div>
  )}

  <div class="hero-copy">
    {preset === 'editorial' && rail && rail.length > 0 && (
      <div class="hero-rail">
        {rail.map((r) => <span>{r}</span>)}
      </div>
    )}
    {eyebrow && !(preset === 'editorial' && rail && rail.length > 0) && (
      <div class="eyebrow brand-eyebrow">
        {eyebrowLogo && <img src={eyebrowLogo} width="18" height="18" alt="" />}
        {eyebrow}
      </div>
    )}
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    <div class="hero-cta">
      {primaryCta && <a class="btn btn-primary" href={primaryCta.href}>{primaryCta.label}</a>}
      {secondaryCta && <a class="btn btn-ghost" href={secondaryCta.href}>{secondaryCta.label}</a>}
      {soon && !primaryCta && <span class="btn btn-ghost" aria-disabled="true">Coming soon</span>}
    </div>
  </div>
</section>
