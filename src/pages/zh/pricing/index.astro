---
import Layout from '../../../layouts/Layout.astro';
import { SITE } from '../../../lib/site';
import { LIVE_TEMPLATES } from '../../../lib/templates';
import PricingGrid from '../../../design/components/PricingGrid.astro';

const { packs } = SITE.pricing;
const costs = LIVE_TEMPLATES.map((t) => t.creditCost ?? 0).filter((n) => n > 0);
const low = Math.min(...costs);
const high = Math.max(...costs);
const clipCredits = low === high ? String(low) : `${low}–${high}`;
---
<Layout
  title={`价格 · ${SITE.name}`}
  description="1 积分大约 1 秒。入门 $5.99，进阶 $14.99，大包 $39.99。"
  canonicalPath="/pricing/"
  lang="zh"
>
  <div class="page-head wrap">
    <h1>价格</h1>
    <p>1 积分大约是短片的 1 秒。套餐价格列在这里。本页不会扣银行卡。</p>
  </div>
  <section class="section wrap">
    <PricingGrid
      oneShotLabel="一条短片"
      oneShotAmount={clipCredits}
      oneShotMeta="积分 · 按素材每秒 1 积分"
      packs={packs}
      packMeta="积分"
      creditUnit="积分"
      popularLabel="热门"
      note="一条短片按该效果素材的秒数计费，四舍五入，每秒 1 积分。短片没完成会退回这些积分。在账户里购买套餐。"
    />
  </section>
</Layout>
