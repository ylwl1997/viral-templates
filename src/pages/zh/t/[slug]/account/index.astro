---
import AccountShell from '../../../../../components/account/AccountShell.astro';
import AccountOverview from '../../../../../components/account/AccountOverview.astro';
import { accountHref } from '../../../../../lib/auth';
import { keywordPath } from '../../../../../lib/site';
import { TEMPLATES, type Template } from '../../../../../lib/templates';

export function getStaticPaths() {
  return TEMPLATES.map((template) => ({
    params: { slug: template.slug },
    props: { template },
  }));
}

interface Props { template: Template }
const { template: t } = Astro.props;
const lang = 'zh' as const;
---
<AccountShell
  lang={lang}
  template={t}
  active="overview"
  title={`账户 · ${t.displayNameZh}`}
  description={`${t.displayNameZh} 账户概览 — 余额与最近作品。`}
>
  <AccountOverview
    lang={lang}
    createHref={keywordPath(lang, t.slug, 'create')}
    creationsHref={accountHref(lang, 'creations')}
    creditsHref={accountHref(lang, 'credits')}
  />
</AccountShell>
