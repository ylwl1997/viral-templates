---
import type { Lang } from '../../lib/site';
import { pathFor } from '../../lib/site';
import { accountHref } from '../../lib/auth';
import type { Template } from '../../lib/templates';

interface Props {
  lang?: Lang;
  template?: Template;
}

const { lang = 'en', template } = Astro.props;
const label = (en: string, zh: string) => (lang === 'zh' ? zh : en);
const nextDefault = accountHref(lang, '');
const backHref = template
  ? (lang === 'zh' ? `/zh/t/${template.slug}/` : `/t/${template.slug}/`)
  : pathFor(lang, '/');
const backLabel = template
  ? label(`← Back to ${template.displayName}`, `← 返回 ${template.displayNameZh}`)
  : label('← Back to templates', '← 返回模板');
---
<section class="section wrap sign-in-section" id="sign-in-panel" data-lang={lang} data-next-default={nextDefault}>
  <p class="account-kicker">{label('Account', '账户')}</p>
  <h1>{label('Sign in', '登录')}</h1>
  <p class="lede" id="sign-in-lede">
    {label('Choose how you want to continue.', '选择登录方式。')}
  </p>
  <div class="card sign-in-card">
    <p class="sign-in-error" id="sign-in-error" hidden></p>
    <!-- Google button only rendered by JS when OAuth is wired -->
    <div id="google-wrap" hidden></div>
    <div id="preview-wrap" hidden>
      <form id="preview-form" class="preview-form">
        <label>
          <span>{label('Email', '邮箱')}</span>
          <input name="email" type="email" value="preview@viral-templates.local" autocomplete="username" />
        </label>
        <label>
          <span>{label('Display name', '显示名')}</span>
          <input
            name="name"
            type="text"
            maxlength="80"
            value={lang === 'zh' ? '预览用户' : 'Preview User'}
            autocomplete="nickname"
          />
        </label>
        <button class="btn btn-primary" type="submit" style="width:100%">
          {label('Preview sign-in', '预览登录')}
        </button>
      </form>
    </div>
    <p class="sign-in-status" id="sign-in-status"></p>
    <p class="sign-in-soon" id="sign-in-soon" hidden>
      {label('Sign-in coming soon.', '登录即将开放。')}
    </p>
    <p class="sign-in-back"><a href={backHref}>{backLabel}</a></p>
  </div>
</section>
<script is:inline src="/scripts/sign-in.js" defer></script>
