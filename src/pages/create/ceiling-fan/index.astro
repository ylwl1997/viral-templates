---
import Layout from '../../../layouts/Layout.astro';
import { SITE, pathFor, getTemplate } from '../../../lib/site';
const lang = 'en' as const;
const t = getTemplate('ceiling-fan');
const { oneShotUsd, creditPerGenerate, packs } = SITE.pricing;
---
<Layout
  title={`Create ${t.nameEn} — ${SITE.name}`}
  description="Upload one adult-consent photo and generate a ~12–15s ceiling-fan outfit-change video. AI only — never strap a phone to a fan."
  canonicalPath="/create/ceiling-fan/"
  lang={lang}
>
  <div class="page-head wrap">
    <h1>Create — {t.nameEn}</h1>
    <p>1 photo → {t.durationEn} outfit-change transition. {creditPerGenerate} credit · from ${oneShotUsd}.</p>
  </div>

  <section class="section wrap">
    <div class="callout warn">
      <strong>Safety first.</strong> This is an <em>AI</em> transition — do <strong>not</strong> strap a phone (or anything) to a real ceiling fan.
      Adult consent photos only. Not affiliated with CapCut or any fan brand.
    </div>

    <div class="credits-bar">
      <div>
        <strong>Credits:</strong> <span id="credit-count">0</span>
        <span class="badge" style="margin-left:0.5rem">demo balance</span>
      </div>
      <div>
        Price: <strong>1 credit</strong> / generate · packs from ${packs[0].usd}
        · <a href={pathFor(lang, '/pricing/')}>Buy credits</a>
      </div>
    </div>

    <div class="studio" style="margin-top:1.25rem">
      <div>
        <label class="upload-zone" for="photo-input">
          <input id="photo-input" type="file" accept="image/jpeg,image/png,image/webp" />
          <div id="upload-placeholder">
            <strong>Drop photo or click to upload</strong>
            <div class="hint">JPG / PNG / WebP · full body preferred · adult consent required</div>
          </div>
          <img id="preview" class="preview-img" alt="Preview" hidden />
        </label>
        <label style="display:flex;gap:0.5rem;align-items:flex-start;margin-top:1rem;font-size:0.92rem;color:var(--secondary)">
          <input id="consent" type="checkbox" style="margin-top:0.25rem" />
          <span>I confirm this photo shows an adult (18+) who consented, and I will not attempt a real-fan phone stunt.</span>
        </label>
      </div>

      <div class="card">
        <h3>Generate</h3>
        <p style="margin-bottom:1rem">Output: vertical 9:16 · {t.durationEn} · AI fan-wipe outfit change.</p>
        <button class="btn btn-primary" id="generate-btn" type="button" style="width:100%">Generate video</button>
        <div class="status-box cfg" id="status">Waiting for photo + consent…
FAL stub — demoable without keys.</div>
        <p style="margin-top:1rem;font-size:0.88rem;color:var(--muted)">
          Failed generates refund the credit. Waffo stub until <code>WAFFO_*</code>.
          · <a href={pathFor(lang, '/')}>← All templates</a>
        </p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const input = document.getElementById('photo-input');
      const preview = document.getElementById('preview');
      const placeholder = document.getElementById('upload-placeholder');
      const consent = document.getElementById('consent');
      const btn = document.getElementById('generate-btn');
      const status = document.getElementById('status');
      let hasFile = false;
      function setStatus(text, kind) {
        status.textContent = text;
        status.className = 'status-box' + (kind ? ' ' + kind : '');
      }
      input.addEventListener('change', function () {
        const file = input.files && input.files[0];
        if (!file) return;
        hasFile = true;
        preview.src = URL.createObjectURL(file);
        preview.hidden = false;
        placeholder.hidden = true;
        setStatus('Photo ready. Confirm consent (and no real-fan stunts), then Generate.', 'cfg');
      });
      btn.addEventListener('click', function () {
        if (!hasFile) { setStatus('Upload one photo first.', 'err'); return; }
        if (!consent.checked) { setStatus('Confirm adult consent + safety.', 'err'); return; }
        setStatus('Demo queue… job_demo_ceilingfan_' + Date.now() + '\nAI-only transition — no physical fan.', 'cfg');
        setTimeout(function () {
          setStatus('Demo complete. Configure FAL_* for real ~12–15s renders.', 'ok');
        }, 1800);
      });
    })();
  </script>
</Layout>
