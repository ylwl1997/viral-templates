---
import { SITE, type Lang, keywordPath, pathFor } from '../lib/site';
import { accountHref, signInHref } from '../lib/auth';
import type { Template } from '../lib/templates';
import MediaCompare from '../design/components/MediaCompare.astro';

interface Props {
  template: Template;
  lang?: Lang;
}
const { template: t, lang = 'en' } = Astro.props;
const label = (en: string, zh: string) => (lang === 'zh' ? zh : en);
const home = keywordPath(lang, t.slug, '');
const credits = t.creditCost ?? 0;
const bandSlots = t.photoSlots && t.photoSlots.length > 1 ? t.photoSlots : null;
const uploadCount = bandSlots ? bandSlots.length : t.photoCount === 1 ? 1 : 0;
const minPhotos = t.minPhotos && t.minPhotos > 0 ? t.minPhotos : uploadCount;
const slots = uploadCount > 1 ? bandSlots.map((_, i) => i) : uploadCount === 1 ? [0] : [];
const uid = `cs-${t.slug}`;
const signInBase = signInHref(lang);
const creditsHref = accountHref(lang, 'credits');
const creationsHref = accountHref(lang, 'creations');
const duration = lang === 'zh' ? t.durationZh : t.durationEn;
const name = lang === 'zh' ? t.displayNameZh : t.displayName;
const primaryCase = t.cases?.[0];
const sources = primaryCase?.sources ?? [];
const photoLabel = label('Pet photo', '宠物照片');
const pairReplaceEn = bandSlots
  ? 'The first photo is the lead pet. Later seats are optional and stay empty if you skip them.'
  : '';
const pairReplaceZh = bandSlots
  ? '第一张是主唱宠物。后面的座位可选，不传就空着。'
  : '';
---
<section class="wrap create-studio" id={uid} data-r2-ready={SITE.r2Configured ? '1' : '0'}>
  <div class="credits-bar" data-credits-bar hidden>
    <div>
      <strong>{label('Credits', '积分')}</strong>
      {' '}<span data-credits-balance>—</span>
      <a href={creditsHref} style="margin-left:0.65rem">{label('Account', '账户')}</a>
    </div>
    <div>
      {label('This look', '这个效果')} <strong>{credits}</strong> {label(credits === 1 ? 'credit' : 'credits', '积分')}
      · <a href={`${home}#pricing`}>{label('Pricing', '价格')}</a>
    </div>
  </div>

  <div class="studio-board">
    <div class="card studio-card">
      <div class="studio-step">
        <span class="step-index">1</span>
        <div>
          <h3>{bandSlots ? label('Pet photos', '宠物照片') : label('Pet photo', '宠物照片')}</h3>
          {bandSlots ? (
            <div class="upload-slots" data-slots={String(bandSlots.length)}>
              {slots.map((i) => (
                <label class="slot" data-slot={i}>
                  <input type="file" accept="image/jpeg,image/png,image/webp" class="slot-file" data-slot={i} />
                  <span class="slot-label">
                    {label(bandSlots[i].labelEn, bandSlots[i].labelZh)}
                    {i > 0 ? label(' · optional', ' · 可选') : ''}
                    <br /><small>JPG, PNG, WebP</small>
                  </span>
                  <img class="slot-preview" data-slot={i} alt="" hidden />
                </label>
              ))}
            </div>
          ) : uploadCount === 1 ? (
            <label class="upload-zone" for={`${uid}-photo`}>
              <input id={`${uid}-photo`} class="slot-file" data-slot="0" type="file" accept="image/jpeg,image/png,image/webp" />
              <div id={`${uid}-ph`}>
                <strong>{label('Drop a pet photo or click to upload', '拖放宠物照片，或点击上传')}</strong>
                <div class="hint">JPG, PNG, WebP · {label('an everyday snapshot you can use', '你可以使用的日常快照')}</div>
              </div>
              <img id={`${uid}-preview`} class="preview-img slot-preview" data-slot="0" alt="" hidden />
            </label>
          ) : (
            <p class="hint">{label('This look is not available yet.', '这个效果还不能生成。')}</p>
          )}
          {bandSlots ? <p class="hint">{label(pairReplaceEn, pairReplaceZh)}</p> : null}
          {bandSlots ? (
            <label class="consent-check">
              <input type="checkbox" data-together />
              <span>{label('These pets are together in the one photo I upload.', '我只上传一张照片，里面的宠物在一起。')}</span>
            </label>
          ) : null}
          <div class="phone-handoff" data-phone-handoff hidden>
            <button type="button" class="btn btn-ghost" data-phone-start>
              {label('Upload from your phone', '用手机上传')}
            </button>
            <div class="phone-qr" data-phone-qr hidden></div>
            <p class="phone-link" data-phone-link hidden></p>
          </div>
        </div>
      </div>

      <div class="studio-step">
        <span class="step-index">2</span>
        <div>
          <h3>{label('Look', '风格')}</h3>
          <slot name="look">
            <p class="look-static">{name} · {duration}</p>
          </slot>
        </div>
      </div>

      <div class="studio-step">
        <span class="step-index">3</span>
        <div>
          <h3>{label('Length', '时长')}</h3>
          <div class="length-option">
            <strong>{duration}</strong>
            <span>{credits} {label(credits === 1 ? 'credit' : 'credits', '积分')}</span>
          </div>
        </div>
      </div>

      <div class="studio-step">
        <span class="step-index">4</span>
        <div>
          <h3>{label('Consent', '授权')}</h3>
          <label class="consent-check">
            <input id={`${uid}-consent`} type="checkbox" />
            <span>
              {label(
                'These photos are pets I can use. No people.',
                '这些照片是我可以使用的宠物。没有人。',
              )}
            </span>
          </label>
        </div>
      </div>

      <div class="studio-actions">
        <button
          class="btn btn-primary"
          id={`${uid}-generate`}
          type="button"
          disabled
          aria-disabled="true"
        >
          {label('Generate', '生成')}
        </button>
        <a class="btn btn-ghost" id={`${uid}-pay`} href={creditsHref}>
          {label('Buy credits', '购买积分')}
        </a>
      </div>
      <div class="status-box" id={`${uid}-status`}>
        {label(
          'Add a pet photo and confirm it to continue.',
          '上传宠物照片并确认后才能继续。',
        )}
      </div>
      <p data-job-follow hidden>
        <a data-job-download hidden rel="noopener noreferrer"></a>
        <a data-creations-link href={creationsHref}>{label('View in Creations', '在作品中查看')}</a>
      </p>
      <p class="debug-only" data-debug-only hidden>
        {label(
          `Debug: generate and pay are not configured on this build. Media storage flag: ${SITE.r2Configured ? 'on' : 'off'}.`,
          `调试：此构建未配置生成与支付。媒体存储标记：${SITE.r2Configured ? '开' : '关'}。`
        )}
      </p>
      <p class="debug-only" data-debug-media hidden></p>
      <p class="studio-note">
        <a href={home}>{label('Back to this look', '返回该风格')}</a>
        · <a href={pathFor(lang, '/faq/')}>FAQ</a>
      </p>
    </div>

    <aside class="studio-side">
      <MediaCompare
        sources={sources}
        sourceLabels={sources.length > 1 ? [`${photoLabel} · A`, `${photoLabel} · B`] : undefined}
        poster={primaryCase?.resultPoster ?? t.poster}
        demoVideo={primaryCase?.resultVideo ?? t.demoVideo}
        alt={label(`${name} sample`, `${name} 示例`)}
        originalLabel={photoLabel}
        resultLabel={label('Result', '生成的视频')}
        note={bandSlots
          ? label(
              `${pairReplaceEn} Generate queues the job. The clip shows on your account when it is ready.`,
              `${pairReplaceZh}生成会把任务排进账户。完成后成片会出现在账户里。`,
            )
          : label(
              'The pet in the photo is the pet in the clip. Generate queues the job. The clip shows on your account when it is ready.',
              '照片里的宠物就是成片里的宠物。生成会把任务排进账户。完成后成片会出现在账户里。',
            )}
        liveOriginal
      />
    </aside>
  </div>
</section>

<script is:inline define:vars={{ photoCount: minPhotos, maxPhotos: uploadCount, uid, signInBase, lang, slug: t.slug }}>
  (function () {
    const root = document.getElementById(uid);
    if (!root) return;
    const files = {};
    const consent = document.getElementById(uid + '-consent');
    const btn = document.getElementById(uid + '-generate');
    const status = document.getElementById(uid + '-status');
    const creditsBar = root.querySelector('[data-credits-bar]');
    const debugEls = root.querySelectorAll('[data-debug-only]');
    function isDebug() {
      try { return new URLSearchParams(location.search).get('debug') === '1'; } catch (e) { return false; }
    }
    debugEls.forEach(function (el) { el.hidden = !isDebug(); });
    function setStatus(text, kind) {
      status.textContent = text;
      status.className = 'status-box' + (kind ? ' ' + kind : '');
    }
    function filledPrefix() {
      var n = 0;
      while (files[String(n)]) n += 1;
      return n;
    }
    function syncGenerate() {
      if (!btn) return;
      var ok = photoCount > 0 && consent && consent.checked && filledPrefix() >= photoCount;
      btn.disabled = !ok;
      if (ok) btn.removeAttribute('aria-disabled');
      else btn.setAttribute('aria-disabled', 'true');
      btn.textContent = lang === 'zh' ? '生成' : 'Generate';
    }
    var draftKey = 'vt-draft:' + slug;
    function photoMessage(kind) {
      if (kind === 'small') return lang === 'zh' ? '请换一张较短边至少 300 像素的照片。' : 'Use a photo at least 300 pixels on the shorter side.';
      if (kind === 'aspect') return lang === 'zh' ? '这张照片太宽或太高了。请换一张更接近常见比例的照片。' : 'That photo is too wide or too tall. Use a more ordinary shape.';
      return lang === 'zh' ? '请上传 JPG、PNG 或 WebP 照片。' : 'Use a JPG, PNG, or WebP photo.';
    }
    function remember() {
      var shots = [];
      var slots = Object.keys(files);
      if (!slots.length && !(consent && consent.checked)) {
        try { localStorage.removeItem(draftKey); } catch (e) {}
        return;
      }
      var left = slots.length;
      if (!left) {
        try { localStorage.setItem(draftKey, JSON.stringify({ consent: true, photos: [], at: Date.now() })); } catch (e) {}
        return;
      }
      slots.forEach(function (slot) {
        var reader = new FileReader();
        reader.onload = function () {
          shots.push({ slot: slot, data: String(reader.result || '') });
          left -= 1;
          if (left) return;
          try {
            localStorage.setItem(draftKey, JSON.stringify({
              consent: !!(consent && consent.checked),
              photos: shots,
              at: Date.now(),
            }));
          } catch (e) {}
        };
        reader.readAsDataURL(files[slot]);
      });
    }
    function applyFile(slot, file) {
      files[slot] = file;
      var preview = root.querySelector('.slot-preview[data-slot="' + slot + '"]');
      var placeholder = document.getElementById(uid + '-ph');
      var url = URL.createObjectURL(file);
      if (preview) {
        preview.src = url;
        preview.hidden = false;
      }
      if (placeholder) placeholder.hidden = true;
      var slotEl = root.querySelector('.slot[data-slot="' + slot + '"]');
      if (slotEl) slotEl.classList.add('has-file');
      var compare = root.querySelector('[data-compare-original="' + slot + '"]');
      if (compare) {
        compare.src = url;
        var fig = compare.closest('figure');
        var cap = fig && fig.querySelector('figcaption');
        if (cap) cap.textContent = lang === 'zh' ? '你的照片' : 'Your photo';
      }
      setStatus(lang === 'zh' ? '照片已就绪。请确认授权。' : 'Photo ready. Confirm consent to continue.', 'cfg');
      syncGenerate();
      remember();
    }
    function preparePhoto(file) {
      return new Promise(function (resolve) {
        if (!file || !/^image\/(jpeg|png|webp)$/i.test(file.type || '')) {
          resolve({ error: 'bad' });
          return;
        }
        var img = new Image();
        var url = URL.createObjectURL(file);
        img.onload = function () {
          var w = img.naturalWidth || 0;
          var h = img.naturalHeight || 0;
          URL.revokeObjectURL(url);
          if (!w || !h) { resolve({ error: 'bad' }); return; }
          if (Math.min(w, h) < 300) { resolve({ error: 'small' }); return; }
          if (Math.max(w, h) / Math.min(w, h) > 2.5) { resolve({ error: 'aspect' }); return; }
          var long = Math.max(w, h);
          var scale = long > 1280 ? 1280 / long : 1;
          if (scale === 1 && file.size < 1200000 && /jpeg/i.test(file.type)) {
            resolve({ file: file });
            return;
          }
          var canvas = document.createElement('canvas');
          canvas.width = Math.max(1, Math.round(w * scale));
          canvas.height = Math.max(1, Math.round(h * scale));
          var ctx = canvas.getContext('2d');
          if (!ctx) { resolve({ error: 'bad' }); return; }
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          canvas.toBlob(function (blob) {
            if (!blob) { resolve({ error: 'bad' }); return; }
            resolve({ file: new File([blob], 'photo.jpg', { type: 'image/jpeg' }) });
          }, 'image/jpeg', 0.86);
        };
        img.onerror = function () {
          URL.revokeObjectURL(url);
          resolve({ error: 'bad' });
        };
        img.src = url;
      });
    }
    root.querySelectorAll('.slot-file').forEach(function (input) {
      input.addEventListener('change', function () {
        var slot = input.getAttribute('data-slot') || '0';
        var file = input.files && input.files[0];
        if (!file) return;
        setStatus(lang === 'zh' ? '正在检查照片…' : 'Checking the photo…', 'cfg');
        preparePhoto(file).then(function (result) {
          if (!result || result.error) {
            delete files[slot];
            setStatus(photoMessage(result && result.error), 'err');
            syncGenerate();
            return;
          }
          applyFile(slot, result.file);
        });
      });
    });
    if (consent) consent.addEventListener('change', function () { syncGenerate(); remember(); });
    try {
      var saved = JSON.parse(localStorage.getItem(draftKey) || 'null');
      if (saved && saved.at && Date.now() - saved.at < 7 * 86400000) {
        if (saved.consent && consent) consent.checked = true;
        (saved.photos || []).forEach(function (shot) {
          if (!shot || typeof shot.data !== 'string' || shot.data.indexOf('data:image/') !== 0) return;
          fetch(shot.data).then(function (r) { return r.blob(); }).then(function (blob) {
            applyFile(String(shot.slot || '0'), new File([blob], 'photo.jpg', { type: blob.type || 'image/jpeg' }));
          }).catch(function () {});
        });
      }
    } catch (e) {}
    var phoneBox = root.querySelector('[data-phone-handoff]');
    var phoneTimer = 0;
    function wideScreen() {
      try { return window.matchMedia('(min-width: 840px)').matches; } catch (e) { return false; }
    }
    function armPhone(user) {
      if (!phoneBox) return;
      phoneBox.hidden = !(user && wideScreen());
    }
    function placeQr(svg) {
      var box = root.querySelector('[data-phone-qr]');
      if (!box) return;
      box.textContent = '';
      box.hidden = false;
      try {
        var doc = new DOMParser().parseFromString(svg, 'image/svg+xml');
        var node = doc.querySelector('svg');
        if (node) box.appendChild(document.importNode(node, true));
      } catch (e) {}
    }
    function pollPhone(token, tries) {
      if (phoneTimer) window.clearTimeout(phoneTimer);
      if (!token || tries > 90) return;
      phoneTimer = window.setTimeout(function () {
        fetch('/api/uploads/phone?token=' + encodeURIComponent(token), { credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data && data.photo) {
              return fetch(data.photo).then(function (r) { return r.blob(); }).then(function (blob) {
                applyFile(String(data.slot || '0'), new File([blob], 'photo.jpg', { type: blob.type || 'image/jpeg' }));
                setStatus(lang === 'zh' ? '手机上的照片已放进这里。' : 'The phone photo is in this draft.', 'cfg');
              });
            }
            pollPhone(token, tries + 1);
          })
          .catch(function () { pollPhone(token, tries + 1); });
      }, 2000);
    }
    var phoneStart = root.querySelector('[data-phone-start]');
    if (phoneStart) {
      phoneStart.addEventListener('click', function () {
        requireUser(function (user) {
          if (!user) {
            setStatus(lang === 'zh' ? '请先登录后再用手机上传。' : 'Sign in to upload from a phone.', 'err');
            goSignIn();
            return;
          }
          var slot = files['0'] && photoCount > 1 && !files['1'] ? 1 : 0;
          fetch('/api/uploads/phone', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ template_slug: slug, slot: slot }),
          })
            .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data || {} }; }); })
            .then(function (res) {
              if (!res.ok || !res.data.url) {
                setStatus(lang === 'zh' ? '手机上传现在不可用。' : 'Phone upload is not available right now.', 'err');
                return;
              }
              placeQr(res.data.svg || '');
              var link = root.querySelector('[data-phone-link]');
              if (link) {
                link.hidden = false;
                link.textContent = res.data.url;
              }
              setStatus(lang === 'zh' ? '用手机打开这个链接，照片会回到这里。' : 'Open this link on your phone. The photo comes back here.', 'cfg');
              pollPhone(res.data.token, 0);
            })
            .catch(function () {
              setStatus(lang === 'zh' ? '手机上传现在不可用。' : 'Phone upload is not available right now.', 'err');
            });
        });
      });
    }
    function goSignIn() {
      var next = location.pathname + location.search + location.hash;
      if (typeof window.vtOpenLogin === 'function') {
        window.vtOpenLogin({ next: next, lang: lang });
        return;
      }
      var url = '/account/sign-in/?next=' + encodeURIComponent(next);
      try {
        var u = new URL(signInBase || '/account/sign-in/', location.origin);
        u.searchParams.set('next', next);
        url = u.pathname + u.search;
      } catch (e) {
        url = '/account/sign-in/?next=' + encodeURIComponent(next);
      }
      location.href = url;
    }
    var watchTimer = 0;
    var WATCH_MS = 30 * 60 * 1000;
    function watchJob(jobId, startedAt) {
      if (watchTimer) window.clearTimeout(watchTimer);
      watchTimer = 0;
      if (!jobId || !startedAt || Date.now() - startedAt > WATCH_MS) return;
      var delay = Date.now() - startedAt < 2000 ? 1500 : 15000;
      watchTimer = window.setTimeout(function () {
        watchTimer = 0;
        fetch('/api/account/creations?limit=10', { credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            var jobs = (data && data.jobs) || [];
            var found = null;
            for (var i = 0; i < jobs.length; i += 1) {
              if (jobs[i] && jobs[i].id === jobId) found = jobs[i];
            }
            if (!found || found.status === 'queued' || found.status === 'running') {
              if (found) {
                var runningNote = lang === 'zh' ? found.note_zh || found.note_en || '' : found.note_en || '';
                if (runningNote) setStatus(runningNote, 'cfg');
              }
              watchJob(jobId, startedAt);
              return;
            }
            var doneNote = lang === 'zh' ? found.note_zh || found.note_en || '' : found.note_en || '';
            if (found.status === 'failed') {
              setStatus(doneNote || (lang === 'zh' ? '视频生成失败。' : 'Video generation failed.'), 'err');
              return;
            }
            setStatus(doneNote || (lang === 'zh' ? '成片可以下载了。' : 'Your clip is ready.'), 'cfg');
            var readyUrl = '';
            if (found.result_url) {
              try {
                var readyParsed = new URL(found.result_url, location.origin);
                if (readyParsed.protocol === 'https:' || readyParsed.protocol === 'http:') readyUrl = readyParsed.href;
              } catch (e) {
                readyUrl = '';
              }
            }
            var readyDownload = root.querySelector('[data-job-download]');
            if (readyDownload && readyUrl) {
              readyDownload.href = readyUrl;
              readyDownload.textContent = lang === 'zh' ? '下载' : 'Download';
              readyDownload.hidden = false;
            }
          })
          .catch(function () {
            watchJob(jobId, startedAt);
          });
      }, delay);
    }
    function refreshBalance() {
      var bal = root.querySelector('[data-credits-balance]');
      fetch('/api/account/credits?ledger=0', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (bal) bal.textContent = data && data.ok ? String(data.balance) : '—';
        })
        .catch(function () {
          if (bal) bal.textContent = '—';
        });
    }
    function applySession(user) {
      var bal = root.querySelector('[data-credits-balance]');
      armPhone(user);
      if (creditsBar) creditsBar.hidden = !user;
      if (!user) {
        if (bal) bal.textContent = '—';
        return;
      }
      refreshBalance();
    }
    if (window.__VT_SESSION__ !== undefined) applySession(window.__VT_SESSION__);
    document.addEventListener('vt:session', function (ev) {
      applySession(ev.detail && ev.detail.user);
    });
    function requireUser(cb) {
      if (window.__VT_SESSION__ !== undefined) {
        cb(window.__VT_SESSION__);
        return;
      }
      fetch('/api/auth/session', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          window.__VT_SESSION__ = data && data.user ? data.user : null;
          applySession(window.__VT_SESSION__);
          cb(window.__VT_SESSION__);
        })
        .catch(function () { cb(null); });
    }
    var busy = false;
    syncGenerate();
    btn.addEventListener('click', function () {
      if (busy || btn.disabled) return;
      requireUser(function (user) {
        if (!user) {
          setStatus(
            lang === 'zh' ? '请先登录后再生成。' : 'Sign in to generate.',
            'err'
          );
          goSignIn();
          return;
        }
        if (photoCount < 1) {
          setStatus(lang === 'zh' ? '这个效果还不能生成。' : 'This look is not available yet.', 'err');
          return;
        }
        if (filledPrefix() < photoCount) {
          setStatus(lang === 'zh' ? '请先上传宠物照片。' : 'Upload a pet photo first.', 'err');
          return;
        }
        if (!consent.checked) {
          setStatus(lang === 'zh' ? '请先确认这是宠物照片。' : 'Confirm these are pet photos first.', 'err');
          return;
        }
        var follow = root.querySelector('[data-job-follow]');
        var download = root.querySelector('[data-job-download]');
        if (follow) follow.hidden = true;
        if (download) download.hidden = true;
        busy = true;
        btn.disabled = true;
        setStatus(lang === 'zh' ? '正在加入队列…' : 'Queuing…', 'cfg');
        var body = new FormData();
        body.append('template_slug', slug);
        body.append('pets_only', '1');
        var together = root.querySelector('[data-together]');
        if (together && together.checked && filledPrefix() === 1) body.append('frame', 'together');
        var prefix = filledPrefix();
        for (var slotIndex = 0; slotIndex < prefix && slotIndex < maxPhotos; slotIndex += 1) {
          var file = files[String(slotIndex)];
          body.append('photo_' + slotIndex, file, file.name || ('photo-' + slotIndex));
        }
        fetch('/api/jobs', {
          method: 'POST',
          credentials: 'same-origin',
          body: body,
        })
          .then(function (r) {
            return r.json().then(function (data) {
              return { ok: r.ok, data: data || {} };
            });
          })
          .then(function (res) {
            var data = res.data || {};
            if (!res.ok || !data.ok) {
              if (data.error === 'unauthorized') {
                setStatus(
                  lang === 'zh' ? '请先登录后再生成。' : 'Sign in to generate.',
                  'err'
                );
                goSignIn();
                return;
              }
              if (data.error === 'insufficient_credits') {
                setStatus(lang === 'zh' ? '积分不够。没完成的短片会退回积分。' : 'Not enough credits. A clip that does not finish returns its credits.', 'err');
                return;
              }
              if (data.error === 'photo_too_small') {
                setStatus(photoMessage('small'), 'err');
                return;
              }
              if (data.error === 'photo_aspect') {
                setStatus(photoMessage('aspect'), 'err');
                return;
              }
              if (data.error === 'bad_photo') {
                setStatus(photoMessage('bad'), 'err');
                return;
              }
              if (data.error === 'photo_too_large') {
                setStatus(lang === 'zh' ? '照片太大了。' : 'That photo is too large.', 'err');
                return;
              }
              setStatus(lang === 'zh' ? '暂时无法保存这个任务。' : 'Could not save this job yet.', 'err');
              return;
            }
            var job = data.job || {};
            var note = lang === 'zh' ? job.note_zh || job.note_en || '' : job.note_en || '';
            var debugMedia = root.querySelector('[data-debug-media]');
            if (debugMedia && isDebug()) {
              var configured = data.media && data.media.r2_configured ? 'on' : 'off';
              var stored = data.media && data.media.stored ? 'stored' : 'not stored';
              var code = data.media && data.media.error ? ' (' + data.media.error + ')' : '';
              debugMedia.hidden = false;
              debugMedia.textContent = 'Debug: media binding ' + configured + ', photo ' + stored + code + '.';
            }
            if (data.media && data.media.error === 'r2_unbound') {
              var miss = lang === 'zh' ? '照片暂时没有保存。' : 'The photo was not saved yet.';
              setStatus(miss + ' ' + (note || (lang === 'zh' ? '已加入队列。' : 'Queued.')), 'err');
            } else {
              setStatus(note || (lang === 'zh' ? '已加入队列。即将开始生成。' : 'Queued. Generation is starting.'), 'cfg');
              watchJob(job.id, Date.now());
            }
            try { localStorage.removeItem(draftKey); } catch (e) {}
            if (follow) follow.hidden = false;
            var media = '';
            if (job.status === 'ready' && job.result_url) {
              try {
                var parsed = new URL(job.result_url, location.origin);
                if (parsed.protocol === 'https:' || parsed.protocol === 'http:') media = parsed.href;
              } catch (e) {
                media = '';
              }
            }
            if (download && media) {
              download.href = media;
              download.textContent = lang === 'zh' ? '下载' : 'Download';
              download.hidden = false;
            }
            refreshBalance();
          })
          .catch(function () {
            setStatus(lang === 'zh' ? '暂时无法保存这个任务。' : 'Could not save this job yet.', 'err');
          })
          .finally(function () {
            busy = false;
            syncGenerate();
          });
      });
    });
  })();
</script>
