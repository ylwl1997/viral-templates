---
import Layout from '../../layouts/Layout.astro';
import { SITE, pathFor, keywordPath } from '../../lib/site';
import { LIVE_TEMPLATES, SOON_TEMPLATES } from '../../lib/templates';
import TemplateGallery from '../../design/components/TemplateGallery.astro';
import StepsHow from '../../design/components/StepsHow.astro';
import FinalCta from '../../design/components/FinalCta.astro';

const lang = 'zh' as const;
const previewA = LIVE_TEMPLATES[0];
const previewB = LIVE_TEMPLATES[1] ?? LIVE_TEMPLATES[0];
---
<Layout
  title={`${SITE.name} — AI 爆款视频模板`}
  description="选择爆款 AI 风格，上传照片，生成竖屏短片。需成人同意。"
  canonicalPath="/"
  lang={lang}
>
  <section class="hero wrap hero-hub">
    <div class="hero-copy">
      <div class="eyebrow">热门风格</div>
      <h1>AI 爆款视频 <span class="grad">模板</span></h1>
      <p class="lede">
        选风格、上传照片、生成竖屏短片。需成人同意。
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={pathFor(lang, '/create/')}>开始制作</a>
        <a class="btn btn-ghost" href="#templates">浏览模板</a>
      </div>
    </div>
    <div class="hero-media-stack" aria-hidden="true">
      <a class="hero-phone-a media-slot" href={keywordPath(lang, previewA.slug, '')} tabindex="-1">
        {previewA.poster ? (
          <img class="media-poster" src={previewA.poster} alt="" width="200" height="356" />
        ) : (
          <div class="media-fallback">
            <img src={previewA.logo} width="56" height="56" alt="" />
          </div>
        )}
        <span class="media-badge">9:16</span>
      </a>
      <a class="hero-phone-b media-slot" href={keywordPath(lang, previewB.slug, '')} tabindex="-1">
        {previewB.poster ? (
          <img class="media-poster" src={previewB.poster} alt="" width="168" height="300" />
        ) : (
          <div class="media-fallback">
            <img src={previewB.logo} width="48" height="48" alt="" />
          </div>
        )}
      </a>
    </div>
  </section>

  <section class="section wrap" id="templates">
    <div class="section-head">
      <h2>模板</h2>
      <p class="sub">可打开并创作的已上线风格。</p>
    </div>
    <TemplateGallery lang={lang} templates={LIVE_TEMPLATES} mode="live" />
  </section>

  <section class="section wrap" id="soon">
    <div class="section-head">
      <h2>即将上线</h2>
      <p class="sub">更多风格筹备中 — 可打开品牌页关注。</p>
    </div>
    <TemplateGallery lang={lang} templates={SOON_TEMPLATES} mode="soon" />
  </section>

  <section class="section wrap" id="how">
    <div class="section-head">
      <h2>如何使用</h2>
      <p class="sub">主站与任意已上线品牌页共用同一套创作流程。</p>
    </div>
    <StepsHow
      steps={[
        { title: '选择模板', body: '浏览热门风格并打开创作。' },
        { title: '上传与授权', body: '仅限成人同意照片。禁止未成年人。' },
        { title: '生成', body: '登录后点生成会把任务排进你的账户。目前还没有成片。支付显示即将开放。' },
      ]}
    />
  </section>

  <FinalCta
    title="准备创作？"
    lede="打开主站创作，或进入已上线品牌页。"
    primary={{ href: pathFor(lang, '/create/'), label: '开始制作' }}
    secondary={{ href: pathFor(lang, '/pricing/'), label: '价格' }}
  />
</Layout>
