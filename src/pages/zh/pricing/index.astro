---
import Layout from '../../../layouts/Layout.astro';
import { SITE } from '../../../lib/site';
import PricingGrid from '../../../design/components/PricingGrid.astro';

const { packs, oneShotUsd, kissCamOneShotUsd } = SITE.pricing;
---
<Layout
  title="价格"
  description="Viral Templates AI 视频产品演示价格。"
  canonicalPath="/pricing/"
  lang="zh"
>
  <div class="page-head wrap"><h1>价格</h1><p>演示价格 — 支付开放后可结账。</p></div>
  <section class="section wrap">
    <PricingGrid
      oneShotLabel="单次"
      oneShotUsd={oneShotUsd}
      oneShotMeta={`Kiss Cam 起 $${kissCamOneShotUsd} · 演示`}
      packs={packs}
      popularLabel="热门"
      note="登录后生成会把任务排进账户并扣积分。购买积分尚未开通。"
    />
  </section>
</Layout>
