---
import { SITE, type Lang, keywordPath, pathFor } from '../lib/site';
import { accountHref, signInHref } from '../lib/auth';
import type { Template } from '../lib/templates';

interface Props {
  template: Template;
  lang?: Lang;
}
const { template: t, lang = 'en' } = Astro.props;
const label = (en: string, zh: string) => (lang === 'zh' ? zh : en);
const home = keywordPath(lang, t.slug, '');
const price =
  t.photoCount === 2 ? SITE.pricing.kissCamOneShotUsd : SITE.pricing.oneShotUsd;
const slots = t.photoCount === 2 ? [0, 1] : [0];
const uid = `cs-${t.slug}`;
const signInBase = signInHref(lang);
const creditsHref = accountHref(lang, 'credits');
const generateReady = SITE.falConfigured;
const payReady = SITE.waffoConfigured;
---
<section class="section wrap create-studio" id={uid} data-generate-ready={generateReady ? '1' : '0'} data-pay-ready={payReady ? '1' : '0'}>
  <div class="callout warn">
    <strong>{label('Adult consent only.', '仅限成人同意。')}</strong>
    {' '}{label(t.disclaimerEn, t.disclaimerZh)}
  </div>

  <div class="credits-bar" data-credits-bar hidden>
    <div>
      <strong>{label('Credits:', '积分：')}</strong>
      <span data-credits-balance>—</span>
      <span class="badge" style="margin-left:0.5rem">{label('Demo', '演示')}</span>
      <a href={creditsHref} style="margin-left:0.65rem;font-size:0.88rem">{label('Account', '账户')}</a>
    </div>
    <div>
      {label('From', '起')} <strong>${price}</strong>
      · <a href={`${home}#pricing`}>{label('Pricing', '价格')}</a>
    </div>
  </div>

  <div class="studio" style="margin-top:1.25rem">
    <div>
      {t.photoCount === 2 ? (
        <div class="upload-slots" data-slots="2">
          {slots.map((i) => (
            <label class="slot" data-slot={i}>
              <input type="file" accept="image/jpeg,image/png,image/webp" class="slot-file" data-slot={i} />
              <span class="slot-label">
                {label(`Photo ${i === 0 ? 'A' : 'B'}`, `照片 ${i === 0 ? 'A' : 'B'}`)}
                <br /><small>{label('Person / pet', '人物 / 宠物')}</small>
              </span>
              <img class="slot-preview" data-slot={i} alt="" hidden />
            </label>
          ))}
        </div>
      ) : (
        <label class="upload-zone" for={`${uid}-photo`}>
          <input id={`${uid}-photo`} class="slot-file" data-slot="0" type="file" accept="image/jpeg,image/png,image/webp" />
          <div id={`${uid}-ph`}>
            <strong>{label('Drop photo or click to upload', '拖放或点击上传照片')}</strong>
            <div class="hint">JPG / PNG / WebP · {label('you must own rights', '需拥有使用权')}</div>
          </div>
          <img id={`${uid}-preview`} class="preview-img slot-preview" data-slot="0" alt="Preview" hidden />
        </label>
      )}
      <label style="display:flex;gap:0.5rem;align-items:flex-start;margin-top:1rem;font-size:0.92rem;color:var(--secondary)">
        <input id={`${uid}-consent`} type="checkbox" style="margin-top:0.25rem" />
        <span>
          {label(
            `I confirm ${t.photoCount === 2 ? 'these photos show' : 'this photo shows'} adult(s) (18+) or pets with permission, and I have rights to use ${t.photoCount === 2 ? 'them' : 'it'}.`,
            `我确认${t.photoCount === 2 ? '这些照片为' : '该照片为'}成人（18+）或经授权宠物，且我拥有使用权。`
          )}
        </span>
      </label>
    </div>

    <div class="card studio-generate-panel">
      <h3>{label('Generate', '生成')}</h3>
      <p style="margin-bottom:0.35rem;color:var(--muted);font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;font-weight:650">
        {label('Output', '输出')}
      </p>
      <p style="margin-bottom:1rem">
        vertical 9:16 · {lang === 'zh' ? t.durationZh : t.durationEn}
      </p>
      <button
        class="btn btn-primary"
        id={`${uid}-generate`}
        type="button"
        style="width:100%"
        disabled
        aria-disabled="true"
      >
        {generateReady
          ? label('Generate video', '生成视频')
          : label('Coming soon', '即将开放')}
      </button>
      <button
        class="btn btn-ghost"
        id={`${uid}-pay`}
        type="button"
        style="width:100%;margin-top:0.65rem"
        disabled={!payReady}
        aria-disabled={!payReady ? 'true' : undefined}
      >
        {payReady ? label('Pay', '支付') : label('Coming soon', '即将开放')}
      </button>
      <div class="status-box" id={`${uid}-status`}>
        {label(
          'Upload photo(s) and confirm consent to continue.',
          '请上传照片并确认授权以继续。'
        )}
      </div>
      <p class="debug-only" data-debug-only hidden style="margin-top:1rem;font-size:0.88rem;color:var(--muted)">
        {label(
          'Debug: generate/pay backends not configured on this host.',
          '调试：本主机未配置生成/支付后端。'
        )}
      </p>
      <p style="margin-top:0.75rem;font-size:0.88rem;">
        <a href={home}>← {label('Back to home', '返回首页')}</a>
        · <a href={pathFor(lang, '/faq/')}>FAQ</a>
      </p>
    </div>
  </div>
</section>

<script is:inline define:vars={{ photoCount: t.photoCount, uid, signInBase, lang, generateReady, payReady }}>
  (function () {
    const root = document.getElementById(uid);
    if (!root) return;
    const files = {};
    const consent = document.getElementById(uid + '-consent');
    const btn = document.getElementById(uid + '-generate');
    const pay = document.getElementById(uid + '-pay');
    const status = document.getElementById(uid + '-status');
    const creditsBar = root.querySelector('[data-credits-bar]');
    const debugEls = root.querySelectorAll('[data-debug-only]');
    function isDebug() {
      try { return new URLSearchParams(location.search).get('debug') === '1'; } catch (e) { return false; }
    }
    debugEls.forEach(function (el) { el.hidden = !isDebug(); });
    function setStatus(text, kind) {
      status.textContent = text;
      status.className = 'status-box' + (kind ? ' ' + kind : '');
    }
    function readyCount() {
      return Object.keys(files).length;
    }
    function syncGenerate() {
      if (!btn) return;
      if (!generateReady) {
        btn.disabled = true;
        btn.setAttribute('aria-disabled', 'true');
        btn.textContent = lang === 'zh' ? '即将开放' : 'Coming soon';
        return;
      }
      var ok = consent && consent.checked && readyCount() >= photoCount;
      btn.disabled = !ok;
      if (ok) btn.removeAttribute('aria-disabled');
      else btn.setAttribute('aria-disabled', 'true');
      btn.textContent = lang === 'zh' ? '生成视频' : 'Generate video';
    }
    root.querySelectorAll('.slot-file').forEach(function (input) {
      input.addEventListener('change', function () {
        const slot = input.getAttribute('data-slot') || '0';
        const file = input.files && input.files[0];
        if (!file) return;
        files[slot] = file;
        const preview = root.querySelector('.slot-preview[data-slot="' + slot + '"]');
        const placeholder = document.getElementById(uid + '-ph');
        if (preview) {
          preview.src = URL.createObjectURL(file);
          preview.hidden = false;
        }
        if (placeholder) placeholder.hidden = true;
        const slotEl = input.closest('.slot');
        if (slotEl) slotEl.classList.add('has-file');
        setStatus(
          lang === 'zh' ? '照片已就绪。请确认授权。' : 'Photo ready. Confirm consent to continue.',
          'cfg'
        );
        syncGenerate();
      });
    });
    if (consent) consent.addEventListener('change', syncGenerate);
    function goSignIn() {
      var next = location.pathname + location.search + location.hash;
      var url = '/account/sign-in/?next=' + encodeURIComponent(next);
      try {
        var u = new URL(signInBase || '/account/sign-in/', location.origin);
        u.searchParams.set('next', next);
        url = u.pathname + u.search;
      } catch (e) {
        url = '/account/sign-in/?next=' + encodeURIComponent(next);
      }
      location.href = url;
    }
    function applySession(user) {
      var bal = root.querySelector('[data-credits-balance]');
      if (creditsBar) creditsBar.hidden = !user;
      if (bal) bal.textContent = user ? '12' : '—';
    }
    if (window.__VT_SESSION__ !== undefined) applySession(window.__VT_SESSION__);
    document.addEventListener('vt:session', function (ev) {
      applySession(ev.detail && ev.detail.user);
    });
    function requireUser(cb) {
      if (window.__VT_SESSION__ !== undefined) {
        cb(window.__VT_SESSION__);
        return;
      }
      fetch('/api/auth/session', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          window.__VT_SESSION__ = data && data.user ? data.user : null;
          applySession(window.__VT_SESSION__);
          cb(window.__VT_SESSION__);
        })
        .catch(function () { cb(null); });
    }
    syncGenerate();
    btn.addEventListener('click', function () {
      if (!generateReady || btn.disabled) return;
      requireUser(function (user) {
        if (!user) {
          setStatus(
            lang === 'zh' ? '请先登录后再生成。正在跳转…' : 'Sign in required. Redirecting…',
            'err'
          );
          goSignIn();
          return;
        }
        if (readyCount() < photoCount) {
          setStatus(lang === 'zh' ? '请先上传照片。' : 'Upload photo(s) first.', 'err');
          return;
        }
        if (!consent.checked) {
          setStatus(lang === 'zh' ? '请先确认成人授权。' : 'Confirm adult consent first.', 'err');
          return;
        }
        setStatus(
          lang === 'zh' ? '生成即将开放。当前为演示。' : 'Generate is coming soon. This is a demo.',
          'cfg'
        );
      });
    });
    if (pay) {
      pay.addEventListener('click', function () {
        if (!payReady) return;
        setStatus(
          lang === 'zh' ? '支付即将开放。' : 'Pay is coming soon.',
          'cfg'
        );
      });
    }
  })();
</script>
