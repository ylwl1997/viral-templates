---
import type { Lang } from '../lib/site';
import { keywordPath } from '../lib/site';
import { LIVE_TEMPLATES } from '../lib/templates';
import CreateStudio from './CreateStudio.astro';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const label = (en: string, zh: string) => (lang === 'zh' ? zh : en);
const first = LIVE_TEMPLATES[0];
---
<div class="hub-create" id="hub-create" data-default={first?.slug}>
  {LIVE_TEMPLATES.map((t, i) => (
    <div class="hub-panel" data-panel={t.slug} hidden={i !== 0}>
      <CreateStudio template={t} lang={lang}>
        <div slot="look">
          <div class="picker-row" role="tablist" aria-label={label('Choose a look', '选择风格')}>
            {LIVE_TEMPLATES.map((opt) => (
              <button
                type="button"
                role="tab"
                class:list={['picker-chip', opt.slug === t.slug && 'is-on']}
                data-pick={opt.slug}
                data-voice={opt.theme.typeVoice}
                data-card={opt.theme.cardStyle}
                data-cover={opt.theme.coverStyle}
                data-ambience={opt.theme.ambience}
                aria-selected={opt.slug === t.slug ? 'true' : 'false'}
              >
                <img src={opt.logo} width="22" height="22" alt="" />
                <span>{lang === 'zh' ? opt.displayNameZh : opt.displayName}</span>
              </button>
            ))}
          </div>
          <p class="picker-hint">
            <a href={keywordPath(lang, t.slug, '')}>
              {label(`Open the ${t.displayName} page`, `打开 ${t.displayNameZh} 页面`)}
            </a>
          </p>
        </div>
      </CreateStudio>
    </div>
  ))}
</div>

<script is:inline>
  (function () {
    var root = document.getElementById('hub-create');
    if (!root) return;
    var params = new URLSearchParams(location.search);
    var want = params.get('t') || root.getAttribute('data-default');
    function show(slug) {
      var match = null;
      root.querySelectorAll('.picker-chip').forEach(function (btn) {
        var on = btn.getAttribute('data-pick') === slug;
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
        if (on && !match) match = btn;
      });
      root.querySelectorAll('.hub-panel').forEach(function (panel) {
        panel.hidden = panel.getAttribute('data-panel') !== slug;
      });
      if (slug && match) {
        document.body.setAttribute('data-theme', slug);
        document.body.setAttribute('data-voice', match.getAttribute('data-voice') || '');
        document.body.setAttribute('data-card', match.getAttribute('data-card') || '');
        document.body.setAttribute('data-cover', match.getAttribute('data-cover') || '');
        document.body.setAttribute('data-ambience', match.getAttribute('data-ambience') || 'none');
        root.setAttribute('data-theme', slug);
      }
      var url = new URL(location.href);
      url.searchParams.set('t', slug);
      history.replaceState(null, '', url.pathname + '?' + url.searchParams.toString() + url.hash);
    }
    root.querySelectorAll('.picker-chip').forEach(function (btn) {
      btn.addEventListener('click', function () {
        show(btn.getAttribute('data-pick'));
      });
    });
    if (want) show(want);
  })();
</script>
