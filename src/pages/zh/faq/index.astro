---
import Layout from '../../../layouts/Layout.astro';
import Accordion from '../../../design/components/Accordion.astro';
---
<Layout
  title="FAQ"
  description="Viral Templates AI 视频产品常见问题。"
  canonicalPath="/faq/"
  lang="zh"
>
  <div class="page-head wrap"><h1>FAQ</h1><p>关于照片、授权、退款与 CapCut 的常见问题。</p></div>
  <section class="section wrap">
    <Accordion
      items={[
        { q: '可以上传什么照片？', a: '清晰、光线充足的成人同意照片效果最好。按模板需要 1 或 2 张。请勿上传未成年人照片。' },
        { q: '需要授权吗？', a: '需要。仅限同意出现在 AI remix 中的成人。Kiss Cam 不含真实演唱会素材。吊扇为纯 AI — 切勿把手机绑在风扇上。' },
        { q: '生成功能可用了吗？', a: '登录后生成会把任务排进你的账户并扣一次积分，目前还不会产出成片。购买积分尚未开通。不会伪造成功视频。' },
        { q: '退款？', a: '本演示未开放结账。支付上线后，退款规则将写在服务条款中。' },
        { q: '你们是 CapCut / Coldplay / Karol G 吗？', a: '不是。独立 AI remix 工具 — 非 CapCut、Coldplay、Karol G 或任何厂牌官方。' },
        { q: '照片保留多久？', a: '上传/任务后约 30 天 — 见隐私政策。' },
      ]}
    />
  </section>
</Layout>
