---
import AccountShell from '../../../../../components/account/AccountShell.astro';
import { TEMPLATES, type Template } from '../../../../../lib/templates';

export function getStaticPaths() {
  return TEMPLATES.map((template) => ({
    params: { slug: template.slug },
    props: { template },
  }));
}

interface Props { template: Template }
const { template: t } = Astro.props;
const lang = 'en' as const;
---
<AccountShell
  lang={lang}
  template={t}
  active="settings"
  title={`Settings · ${t.displayName}`}
  description={`Account profile settings for ${t.displayName}.`}
>
  <header class="account-page-head">
    <h1>Settings</h1>
    <p>Profile is read-only from your session in P0. Delete account / export are not available.</p>
  </header>
  <div class="card settings-card">
    <dl class="settings-dl">
      <div>
        <dt>Display name</dt>
        <dd data-session-name>—</dd>
      </div>
      <div>
        <dt>Email</dt>
        <dd data-session-email>—</dd>
      </div>
      <div>
        <dt>User id</dt>
        <dd><code data-session-id>—</code></dd>
      </div>
      <div>
        <dt>Providers</dt>
        <dd>Preview</dd>
      </div>
    </dl>
  </div>
</AccountShell>
