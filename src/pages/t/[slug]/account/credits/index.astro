---
import AccountShell from '../../../../../components/account/AccountShell.astro';
import AccountCredits from '../../../../../components/account/AccountCredits.astro';
import { TEMPLATES, type Template } from '../../../../../lib/templates';

export function getStaticPaths() {
  return TEMPLATES.map((template) => ({
    params: { slug: template.slug },
    props: { template },
  }));
}

interface Props { template: Template }
const { template: t } = Astro.props;
const lang = 'en' as const;
---
<AccountShell
  lang={lang}
  template={t}
  active="credits"
  title={`Credits · ${t.displayName}`}
  description={`Credit balance and ledger for your ${t.displayName} account.`}
>
  <AccountCredits lang={lang} />
</AccountShell>
