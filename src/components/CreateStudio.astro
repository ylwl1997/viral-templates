---
import { SITE, type Lang, keywordPath, pathFor } from '../lib/site';
import { accountHref, signInHref } from '../lib/auth';
import type { Template } from '../lib/templates';
import MediaCompare from '../design/components/MediaCompare.astro';

interface Props {
  template: Template;
  lang?: Lang;
}
const { template: t, lang = 'en' } = Astro.props;
const label = (en: string, zh: string) => (lang === 'zh' ? zh : en);
const home = keywordPath(lang, t.slug, '');
const price =
  t.photoCount === 2 ? SITE.pricing.kissCamOneShotUsd : SITE.pricing.oneShotUsd;
const slots = t.photoCount === 2 ? [0, 1] : [0];
const uid = `cs-${t.slug}`;
const signInBase = signInHref(lang);
const creditsHref = accountHref(lang, 'credits');
const creationsHref = accountHref(lang, 'creations');
const generateReady = SITE.falConfigured;
const payReady = SITE.waffoConfigured;
const duration = lang === 'zh' ? t.durationZh : t.durationEn;
const name = lang === 'zh' ? t.displayNameZh : t.displayName;
---
<section class="wrap create-studio" id={uid} data-generate-ready={generateReady ? '1' : '0'} data-pay-ready={payReady ? '1' : '0'}>
  <div class="credits-bar" data-credits-bar hidden>
    <div>
      <strong>{label('Credits', '积分')}</strong>
      {' '}<span data-credits-balance>—</span>
      <a href={creditsHref} style="margin-left:0.65rem">{label('Account', '账户')}</a>
    </div>
    <div>
      {label('From', '起')} <strong>${price}</strong>
      · <a href={`${home}#pricing`}>{label('Pricing', '价格')}</a>
    </div>
  </div>

  <div class="studio-board">
    <div class="card studio-card">
      <div class="studio-step">
        <span class="step-index">1</span>
        <div>
          <h3>{label('Your photo', '你的照片')}</h3>
          {t.photoCount === 2 ? (
            <div class="upload-slots" data-slots="2">
              {slots.map((i) => (
                <label class="slot" data-slot={i}>
                  <input type="file" accept="image/jpeg,image/png,image/webp" class="slot-file" data-slot={i} />
                  <span class="slot-label">
                    {label(`Photo ${i === 0 ? 'A' : 'B'}`, `照片 ${i === 0 ? 'A' : 'B'}`)}
                    <br /><small>JPG, PNG, WebP</small>
                  </span>
                  <img class="slot-preview" data-slot={i} alt="" hidden />
                </label>
              ))}
            </div>
          ) : (
            <label class="upload-zone" for={`${uid}-photo`}>
              <input id={`${uid}-photo`} class="slot-file" data-slot="0" type="file" accept="image/jpeg,image/png,image/webp" />
              <div id={`${uid}-ph`}>
                <strong>{label('Drop a photo or click to upload', '拖放照片，或点击上传')}</strong>
                <div class="hint">JPG, PNG, WebP · {label('you need the rights to use it', '需拥有使用权')}</div>
              </div>
              <img id={`${uid}-preview`} class="preview-img slot-preview" data-slot="0" alt="" hidden />
            </label>
          )}
        </div>
      </div>

      <div class="studio-step">
        <span class="step-index">2</span>
        <div>
          <h3>{label('Look', '风格')}</h3>
          <slot name="look">
            <p class="look-static">{name} · {duration}</p>
          </slot>
        </div>
      </div>

      <div class="studio-step">
        <span class="step-index">3</span>
        <div>
          <h3>{label('Length', '时长')}</h3>
          <div class="length-option">
            <strong>{duration}</strong>
            <span>${price} · {SITE.pricing.creditPerGenerate} {label(SITE.pricing.creditPerGenerate === 1 ? 'credit' : 'credits', '积分')}</span>
          </div>
        </div>
      </div>

      <div class="studio-step">
        <span class="step-index">4</span>
        <div>
          <h3>{label('Consent', '授权')}</h3>
          <label class="consent-check">
            <input id={`${uid}-consent`} type="checkbox" />
            <span>
              {label(
                `This photo is of me, or I have permission. ${t.photoCount === 2 ? 'Both people are' : 'They are'} 18 or older, or it is a pet with the owner’s permission.`,
                `这是我本人，或我已获得授权。${t.photoCount === 2 ? '两人均' : '对方'}年满 18 岁，或为已获主人同意的宠物。`
              )}
            </span>
          </label>
        </div>
      </div>

      <div class="studio-actions">
        <button
          class="btn btn-primary"
          id={`${uid}-generate`}
          type="button"
          disabled
          aria-disabled="true"
        >
          {label('Generate', '生成')}
        </button>
        <button
          class="btn btn-ghost"
          id={`${uid}-pay`}
          type="button"
          disabled={!payReady}
          aria-disabled={!payReady ? 'true' : undefined}
        >
          {payReady ? label('Pay', '支付') : label('Coming soon', '即将开放')}
        </button>
      </div>
      <div class="status-box" id={`${uid}-status`}>
        {label(
          'Add a photo and confirm consent to continue.',
          '上传照片并确认授权后才能继续。'
        )}
      </div>
      <p data-job-follow hidden>
        <a data-job-download hidden rel="noopener noreferrer"></a>
        <a data-creations-link href={creationsHref}>{label('View in Creations', '在作品中查看')}</a>
      </p>
      <p class="debug-only" data-debug-only hidden>
        {label(
          'Debug: generate and pay are not configured on this host.',
          '调试：本主机未配置生成与支付。'
        )}
      </p>
      <p class="studio-note">
        <a href={home}>{label('Back to this look', '返回该风格')}</a>
        · <a href={pathFor(lang, '/faq/')}>FAQ</a>
      </p>
    </div>

    <aside class="studio-side">
      <MediaCompare
        poster={t.poster}
        alt={label(`${name} template look`, `${name} 模板效果`)}
        originalLabel={label('Sample still', '示例原片')}
        resultLabel={label('Template look', '模板效果')}
        note={label(
          'The still on the left is a sample. Your upload replaces it. Generate saves a queued job — a finished clip is not available yet.',
          '左侧是示例静帧，上传后会换成你的照片。生成只会把任务排进账户，目前还没有成片。'
        )}
        liveOriginal
      />
    </aside>
  </div>
</section>

<script is:inline define:vars={{ photoCount: t.photoCount, uid, signInBase, lang, slug: t.slug, payReady }}>
  (function () {
    const root = document.getElementById(uid);
    if (!root) return;
    const files = {};
    const consent = document.getElementById(uid + '-consent');
    const btn = document.getElementById(uid + '-generate');
    const pay = document.getElementById(uid + '-pay');
    const status = document.getElementById(uid + '-status');
    const creditsBar = root.querySelector('[data-credits-bar]');
    const debugEls = root.querySelectorAll('[data-debug-only]');
    function isDebug() {
      try { return new URLSearchParams(location.search).get('debug') === '1'; } catch (e) { return false; }
    }
    debugEls.forEach(function (el) { el.hidden = !isDebug(); });
    function setStatus(text, kind) {
      status.textContent = text;
      status.className = 'status-box' + (kind ? ' ' + kind : '');
    }
    function readyCount() {
      return Object.keys(files).length;
    }
    function syncGenerate() {
      if (!btn) return;
      var ok = consent && consent.checked && readyCount() >= photoCount;
      btn.disabled = !ok;
      if (ok) btn.removeAttribute('aria-disabled');
      else btn.setAttribute('aria-disabled', 'true');
      btn.textContent = lang === 'zh' ? '生成' : 'Generate';
    }
    root.querySelectorAll('.slot-file').forEach(function (input) {
      input.addEventListener('change', function () {
        const slot = input.getAttribute('data-slot') || '0';
        const file = input.files && input.files[0];
        if (!file) return;
        files[slot] = file;
        const preview = root.querySelector('.slot-preview[data-slot="' + slot + '"]');
        const placeholder = document.getElementById(uid + '-ph');
        var url = URL.createObjectURL(file);
        if (preview) {
          preview.src = url;
          preview.hidden = false;
        }
        if (placeholder) placeholder.hidden = true;
        const slotEl = input.closest('.slot');
        if (slotEl) slotEl.classList.add('has-file');
        if (slot === '0') {
          var compare = root.querySelector('[data-compare-original]');
          var cap = root.querySelector('[data-compare-caption]');
          if (compare) compare.src = url;
          if (cap) cap.textContent = lang === 'zh' ? '你的照片' : 'Your photo';
        }
        setStatus(
          lang === 'zh' ? '照片已就绪。请确认授权。' : 'Photo ready. Confirm consent to continue.',
          'cfg'
        );
        syncGenerate();
      });
    });
    if (consent) consent.addEventListener('change', syncGenerate);
    function goSignIn() {
      var next = location.pathname + location.search + location.hash;
      var url = '/account/sign-in/?next=' + encodeURIComponent(next);
      try {
        var u = new URL(signInBase || '/account/sign-in/', location.origin);
        u.searchParams.set('next', next);
        url = u.pathname + u.search;
      } catch (e) {
        url = '/account/sign-in/?next=' + encodeURIComponent(next);
      }
      location.href = url;
    }
    function refreshBalance() {
      var bal = root.querySelector('[data-credits-balance]');
      fetch('/api/account/credits?ledger=0', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (bal) bal.textContent = data && data.ok ? String(data.balance) : '—';
        })
        .catch(function () {
          if (bal) bal.textContent = '—';
        });
    }
    function applySession(user) {
      var bal = root.querySelector('[data-credits-balance]');
      if (creditsBar) creditsBar.hidden = !user;
      if (!user) {
        if (bal) bal.textContent = '—';
        return;
      }
      refreshBalance();
    }
    if (window.__VT_SESSION__ !== undefined) applySession(window.__VT_SESSION__);
    document.addEventListener('vt:session', function (ev) {
      applySession(ev.detail && ev.detail.user);
    });
    function requireUser(cb) {
      if (window.__VT_SESSION__ !== undefined) {
        cb(window.__VT_SESSION__);
        return;
      }
      fetch('/api/auth/session', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          window.__VT_SESSION__ = data && data.user ? data.user : null;
          applySession(window.__VT_SESSION__);
          cb(window.__VT_SESSION__);
        })
        .catch(function () { cb(null); });
    }
    var busy = false;
    syncGenerate();
    btn.addEventListener('click', function () {
      if (busy || btn.disabled) return;
      requireUser(function (user) {
        if (!user) {
          setStatus(
            lang === 'zh' ? '请先登录后再生成。正在跳转…' : 'Sign in required. Redirecting…',
            'err'
          );
          goSignIn();
          return;
        }
        if (readyCount() < photoCount) {
          setStatus(lang === 'zh' ? '请先上传照片。' : 'Upload photo(s) first.', 'err');
          return;
        }
        if (!consent.checked) {
          setStatus(lang === 'zh' ? '请先确认成人授权。' : 'Confirm adult consent first.', 'err');
          return;
        }
        var follow = root.querySelector('[data-job-follow]');
        var download = root.querySelector('[data-job-download]');
        if (follow) follow.hidden = true;
        if (download) download.hidden = true;
        busy = true;
        btn.disabled = true;
        setStatus(lang === 'zh' ? '正在加入队列…' : 'Queuing…', 'cfg');
        fetch('/api/jobs', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ template_slug: slug }),
        })
          .then(function (r) {
            return r.json().then(function (data) {
              return { ok: r.ok, data: data || {} };
            });
          })
          .then(function (res) {
            var data = res.data || {};
            if (!res.ok || !data.ok) {
              if (data.error === 'unauthorized') {
                setStatus(
                  lang === 'zh' ? '请先登录后再生成。正在跳转…' : 'Sign in required. Redirecting…',
                  'err'
                );
                goSignIn();
                return;
              }
              setStatus(lang === 'zh' ? '暂时无法保存这个任务。' : 'Could not save this job yet.', 'err');
              return;
            }
            var job = data.job || {};
            var note = lang === 'zh' ? job.note_zh || job.note_en || '' : job.note_en || '';
            setStatus(note || (lang === 'zh' ? '已加入队列。' : 'Queued.'), 'cfg');
            if (follow) follow.hidden = false;
            var media = '';
            if (job.status === 'ready' && job.result_url) {
              try {
                var parsed = new URL(job.result_url, location.origin);
                if (parsed.protocol === 'https:' || parsed.protocol === 'http:') media = parsed.href;
              } catch (e) {
                media = '';
              }
            }
            if (download && media) {
              download.href = media;
              download.textContent = lang === 'zh' ? '下载' : 'Download';
              download.hidden = false;
            }
            refreshBalance();
          })
          .catch(function () {
            setStatus(lang === 'zh' ? '暂时无法保存这个任务。' : 'Could not save this job yet.', 'err');
          })
          .finally(function () {
            busy = false;
            syncGenerate();
          });
      });
    });
    if (pay) {
      pay.addEventListener('click', function () {
        if (!payReady) return;
        setStatus(
          lang === 'zh' ? '支付即将开放。' : 'Pay is coming soon.',
          'cfg'
        );
      });
    }
  })();
</script>
