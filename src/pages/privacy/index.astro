---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../lib/site';
---
<Layout
  title={`Privacy · ${SITE.name}`}
  description={`Privacy policy for ${SITE.name}.`}
  canonicalPath="/privacy/"
  lang="en"
>
  <div class="page-head wrap"><h1>Privacy</h1><p>How long photos and finished clips are kept.</p></div>
  <section class="section wrap prose">
    <p>Adult consent only. Do not upload photos of minors. Uploaded photos are kept for about {SITE.photoRetentionDays} days. Finished clips, when a job has one, are kept for about {SITE.videoRetentionDays} days.</p>
  </section>
</Layout>
