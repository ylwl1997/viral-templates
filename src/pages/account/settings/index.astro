---
import AccountShell from '../../../components/account/AccountShell.astro';

const lang = 'en' as const;
---
<AccountShell
  lang={lang}
  active="settings"
  title="Settings · Viral Templates"
  description="Account profile settings for Viral Templates."
>
  <header class="account-page-head">
    <h1>Settings</h1>
    <p>Your name and email come from the account you signed in with.</p>
  </header>
  <div class="card settings-card">
    <dl class="settings-dl">
      <div>
        <dt>Display name</dt>
        <dd data-session-name>—</dd>
      </div>
      <div>
        <dt>Email</dt>
        <dd data-session-email>—</dd>
      </div>
      <div>
        <dt>User id</dt>
        <dd><code data-session-id>—</code></dd>
      </div>
      <div>
        <dt>Signed in with</dt>
        <dd data-session-providers>—</dd>
      </div>
    </dl>
  </div>
</AccountShell>
