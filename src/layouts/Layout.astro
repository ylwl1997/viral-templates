---
import '../styles/global.css';
import { SITE, type Lang, pathFor } from '../lib/site';
import SiteHeader from '../design/components/SiteHeader.astro';
import SiteFooter from '../design/components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  lang?: Lang;
  ogType?: string;
}

const {
  title,
  description,
  canonicalPath,
  lang = 'en',
  ogType = 'website',
} = Astro.props;

const site = SITE.url;
const pagePath = pathFor(lang, canonicalPath);
const canonical = `${site}${pagePath}`;
const enUrl = `${site}${pathFor('en', canonicalPath)}`;
const zhUrl = `${site}${pathFor('zh', canonicalPath)}`;
const htmlLang = lang === 'zh' ? 'zh-CN' : 'en';
const path = Astro.url.pathname;
const label = (en: string, zh: string) => (lang === 'zh' ? zh : en);
const homeHref = pathFor(lang, '/');
const ga4 = SITE.ga4Id;

const isCurrent = (p: string) => {
  const localized = pathFor(lang, p);
  if (p === '/') return path === localized || path === '/zh' || path === '/zh/';
  return path === localized || path.startsWith(localized);
};

const nav = [
  { href: homeHref, label: label('Templates', '模板'), current: isCurrent('/') },
  { href: pathFor(lang, '/create/'), label: label('Create', '创作'), current: isCurrent('/create/') },
  { href: pathFor(lang, '/pricing/'), label: label('Pricing', '价格'), current: isCurrent('/pricing/') },
  { href: pathFor(lang, '/faq/'), label: 'FAQ', current: isCurrent('/faq/') },
];

const footerCols = [
  {
    title: label('Legal', '法律'),
    links: [
      { href: pathFor(lang, '/terms/'), label: label('Terms', '服务条款') },
      { href: pathFor(lang, '/privacy/'), label: label('Privacy', '隐私政策') },
      { href: pathFor(lang, '/faq/'), label: 'FAQ' },
      { href: pathFor(lang, '/pricing/'), label: label('Pricing', '价格') },
    ],
  },
];
---
<!doctype html>
<html lang={htmlLang} data-shell="hub">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#070b14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {ga4 && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
        <script is:inline define:vars={{ ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4);
        </script>
      </>
    )}
  </head>
  <body data-shell="hub" data-ambience="none" data-card="soft" data-voice="cool">
    <SiteHeader
      lang={lang}
      homeHref={homeHref}
      logoSrc="/brand/logo.svg"
      brandName={SITE.name}
      nav={nav}
      canonicalPath={canonicalPath}
      enHref={pathFor('en', canonicalPath)}
      zhHref={pathFor('zh', canonicalPath)}
      nextPath={Astro.url.pathname + (Astro.url.search || '')}
    />
    <main>
      <slot />
    </main>
    <SiteFooter
      lang={lang}
      brandName={SITE.name}
      tagline={label(SITE.taglineEn, SITE.taglineZh)}
      disclaimer={label(SITE.disclaimerEn, SITE.disclaimerZh)}
      columns={footerCols}
    />
    <script is:inline src="/scripts/header-auth.js" defer></script>
  </body>
</html>
