---
import Layout from '../../layouts/Layout.astro';
import { SITE, keywordPath } from '../../lib/site';
import { LIVE_TEMPLATES, SOON_TEMPLATES } from '../../lib/templates';
---
<Layout
  title={`${SITE.name} — 关键词目录`}
  description="一词一子域轻量目录。每个 live 关键词有独立单站壳（路径回退 /zh/t/{slug}/）。"
  canonicalPath="/"
  lang="zh"
>
  <section class="hero wrap">
    <div class="eyebrow">一词一子域 · 目录</div>
    <h1>关键词站点。<span class="grad">一词一域。</span></h1>
    <p class="lede">
      {SITE.taglineZh}。根域只做轻量索引；每个 live 关键词对应
      <code>{`{slug}.${SITE.apex}`}</code>（预览路径 <code>/zh/t/{`{slug}`}/</code>）。
    </p>
  </section>

  <section class="section wrap" id="live">
    <h2>已上线</h2>
    <p class="sub">独立单站壳。打开关键词即可创作。</p>
    <div class="dir-list">
      {LIVE_TEMPLATES.map((t) => (
        <a class="dir-row" href={keywordPath('zh', t.slug, '')}>
          <span class:list={['dir-swatch', t.accent]} aria-hidden="true" />
          <span class="dir-main">
            <strong>{t.displayNameZh}</strong>
            <span class="dir-meta">{t.taglineZh}</span>
          </span>
          <span class="badge">{t.photoCount} 张 · live</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap" id="soon">
    <h2>即将上线</h2>
    <p class="sub">已预留壳页 — 暂不可生成。</p>
    <div class="dir-list">
      {SOON_TEMPLATES.map((t) => (
        <a class="dir-row soon" href={keywordPath('zh', t.slug, '')}>
          <span class:list={['dir-swatch', t.accent]} aria-hidden="true" />
          <span class="dir-main">
            <strong>{t.displayNameZh}</strong>
            <span class="dir-meta">{t.taglineZh}</span>
          </span>
          <span class="badge">soon</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
