---
import KeywordLayout from '../../../layouts/KeywordLayout.astro';
import { TEMPLATES, type Template } from '../../../lib/templates';
import { SITE, keywordPath } from '../../../lib/site';
import BrandHero from '../../../design/components/BrandHero.astro';
import StepsHow from '../../../design/components/StepsHow.astro';
import PricingGrid from '../../../design/components/PricingGrid.astro';
import FinalCta from '../../../design/components/FinalCta.astro';

export function getStaticPaths() {
  return TEMPLATES.map((template) => ({
    params: { slug: template.slug },
    props: { template },
  }));
}

interface Props { template: Template }
const { template: t } = Astro.props;
const lang = 'en' as const;
const isLive = t.status === 'live';
const createHref = keywordPath(lang, t.slug, 'create');
const { packs, oneShotUsd, kissCamOneShotUsd } = SITE.pricing;
const oneShot = t.photoCount === 2 ? kissCamOneShotUsd : oneShotUsd;
const theme = t.theme;
---
<KeywordLayout
  template={t}
  title={t.seoTitleEn}
  description={t.seoDescEn}
  page=""
  lang={lang}
>
  {isLive ? (
    <>
      <BrandHero
        preset={theme.heroPreset}
        eyebrow={`9:16 · ${t.durationEn}`}
        eyebrowLogo={t.logo}
        title={t.heroEn}
        lede={`${t.taglineEn}. Needs ${t.photoCount} photo${t.photoCount === 2 ? 's' : ''} — upload in Create. Adult consent required.`}
        logo={t.logo}
        mediaSrc={t.poster}
        mediaAlt={`${t.displayName} 9:16 preview`}
        rail={theme.heroPreset === 'editorial' ? [t.displayName, `${t.photoCount} photos`, t.durationEn, 'AI remix'] : undefined}
        primaryCta={{ href: createHref, label: 'Create now' }}
        secondaryCta={{ href: '#how', label: 'How it works' }}
      />

      <section class="section wrap" id="how">
        <h2>How it works</h2>
        <p class="sub">Three simple steps.</p>
        <StepsHow
          steps={t.howEn.map((step, i) => ({ title: `Step ${i + 1}`, body: step }))}
        />
      </section>

      <section class="section wrap" id="pricing">
        <h2>Pricing</h2>
        <p class="sub">Demo figures — checkout opens when payments are ready.</p>
        <PricingGrid
          oneShotLabel="One-shot"
          oneShotUsd={oneShot}
          oneShotMeta={`${SITE.pricing.creditPerGenerate} credit / generate · Demo`}
          packs={packs}
          note="Pay on Create shows Coming soon until checkout is ready."
        />
      </section>

      <section class="section wrap">
        <div class="callout warn">
          <strong>Compliance.</strong> {t.disclaimerEn} Photos deleted ~{SITE.photoRetentionDays} days — see <a href="/privacy/">Privacy</a> / <a href="/terms/">Terms</a> / <a href="/faq/">FAQ</a>.
        </div>
      </section>

      <FinalCta
        title={`Create with ${t.displayName}`}
        lede="Upload, confirm consent, then generate when ready."
        primary={{ href: createHref, label: 'Create now' }}
        secondary={{ href: '#pricing', label: 'Pricing' }}
      />
    </>
  ) : (
    <BrandHero
      preset={theme.heroPreset}
      eyebrow="Coming soon"
      eyebrowLogo={t.logo}
      title={t.displayName}
      lede={`${t.taglineEn}. We’re polishing this experience — create isn’t open yet.`}
      logo={t.logo}
      rail={theme.heroPreset === 'editorial' ? [t.displayName, 'Coming soon'] : undefined}
      soon
    />
  )}
</KeywordLayout>
