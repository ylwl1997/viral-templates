---
import Layout from '../../layouts/Layout.astro';
import KeywordLayout from '../../layouts/KeywordLayout.astro';
import AccountFrame from './AccountFrame.astro';
import type { Lang } from '../../lib/site';
import type { Template } from '../../lib/templates';

interface Props {
  lang?: Lang;
  title: string;
  description: string;
  active: 'overview' | 'creations' | 'credits' | 'settings';
  /** When set, wrap with that brand shell (logo/nav/accent). */
  template?: Template;
}

const { lang = 'en', title, description, active, template } = Astro.props;
const canonicalPath =
  active === 'overview'
    ? '/account/'
    : `/account/${active}/`;
const accountPage =
  active === 'overview' ? 'account' as const
  : active === 'creations' ? 'account/creations' as const
  : active === 'credits' ? 'account/credits' as const
  : 'account/settings' as const;
const brandTitle = template
  ? (lang === 'zh'
      ? `${title.replace(/ · .*$/, '')} · ${template.displayNameZh}`
      : `${title.replace(/ · .*$/, '')} · ${template.displayName}`)
  : title;
---

{template ? (
  <KeywordLayout
    template={template}
    title={brandTitle}
    description={description}
    page={accountPage}
    lang={lang}
  >
    <AccountFrame lang={lang} active={active} template={template}>
      <slot />
    </AccountFrame>
  </KeywordLayout>
) : (
  <Layout title={title} description={description} canonicalPath={canonicalPath} lang={lang}>
    <AccountFrame lang={lang} active={active}>
      <slot />
    </AccountFrame>
  </Layout>
)}
