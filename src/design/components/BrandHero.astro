---
import type { HeroPreset } from '../../lib/templates';

interface Props {
  preset: HeroPreset;
  eyebrow?: string;
  eyebrowLogo?: string;
  title: string;
  /** Optional HTML-safe gradient span mark — pass plain title otherwise */
  lede: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  rail?: string[];
  logo?: string;
  soon?: boolean;
}

const {
  preset,
  eyebrow,
  eyebrowLogo,
  title,
  lede,
  primaryCta,
  secondaryCta,
  rail,
  logo,
  soon,
} = Astro.props;
---
<section class:list={['hero', 'wrap', `hero-preset-${preset}`, soon && 'soon-hero']}>
  {preset === 'split' ? (
    <>
      <div class="hero-visual" aria-hidden="true">
        {logo && <img src={logo} width="88" height="88" alt="" />}
      </div>
      <div class="hero-copy">
        {eyebrow && (
          <div class="eyebrow brand-eyebrow">
            {eyebrowLogo && <img src={eyebrowLogo} width="18" height="18" alt="" />}
            {eyebrow}
          </div>
        )}
        <h1>{title}</h1>
        <p class="lede">{lede}</p>
        <div class="hero-cta">
          {primaryCta && <a class="btn btn-primary" href={primaryCta.href}>{primaryCta.label}</a>}
          {secondaryCta && <a class="btn btn-ghost" href={secondaryCta.href}>{secondaryCta.label}</a>}
          {soon && !primaryCta && <span class="btn btn-ghost" aria-disabled="true">Coming soon</span>}
        </div>
      </div>
    </>
  ) : preset === 'editorial' ? (
    <>
      {rail && rail.length > 0 && (
        <div class="hero-rail">
          {rail.map((r) => <span>{r}</span>)}
        </div>
      )}
      {eyebrow && !rail && (
        <div class="eyebrow brand-eyebrow">
          {eyebrowLogo && <img src={eyebrowLogo} width="18" height="18" alt="" />}
          {eyebrow}
        </div>
      )}
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <div class="hero-cta">
        {primaryCta && <a class="btn btn-primary" href={primaryCta.href}>{primaryCta.label}</a>}
        {secondaryCta && <a class="btn btn-ghost" href={secondaryCta.href}>{secondaryCta.label}</a>}
        {soon && !primaryCta && <span class="btn btn-ghost" aria-disabled="true">Coming soon</span>}
      </div>
    </>
  ) : (
    <>
      {eyebrow && (
        <div class="eyebrow brand-eyebrow">
          {eyebrowLogo && <img src={eyebrowLogo} width="18" height="18" alt="" />}
          {eyebrow}
        </div>
      )}
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <div class="hero-cta">
        {primaryCta && <a class="btn btn-primary" href={primaryCta.href}>{primaryCta.label}</a>}
        {secondaryCta && <a class="btn btn-ghost" href={secondaryCta.href}>{secondaryCta.label}</a>}
        {soon && !primaryCta && <span class="btn btn-ghost" aria-disabled="true">Coming soon</span>}
      </div>
    </>
  )}
</section>
