---
import KeywordLayout from '../../../../../layouts/KeywordLayout.astro';
import CreateStudio from '../../../../../components/CreateStudio.astro';
import { TEMPLATES, type Template } from '../../../../../lib/templates';
import { keywordPath } from '../../../../../lib/site';

export function getStaticPaths() {
  return TEMPLATES.map((template) => ({
    params: { slug: template.slug },
    props: { template },
  }));
}

interface Props { template: Template }
const { template: t } = Astro.props;
const lang = 'zh' as const;
const isLive = t.status === 'live';
---
<KeywordLayout
  template={t}
  title={isLive ? `创作 — ${t.seoTitleZh}` : `${t.displayNameZh} — 即将上线`}
  description={t.seoDescZh}
  page="create"
  lang={lang}
>
  {isLive ? (
    <>
      <div class="page-head wrap">
        <h1>创作 — {t.displayNameZh}</h1>
        <p>{t.taglineZh}。生成与支付为占位 — 不会伪造成功。</p>
      </div>
      <CreateStudio template={t} lang={lang} />
    </>
  ) : (
    <section class="hero wrap">
      <div class="eyebrow">即将上线</div>
      <h1>{t.displayNameZh}</h1>
      <p class="lede">该关键词暂未开放创作。</p>
      <a class="btn btn-primary" href={keywordPath(lang, t.slug, '')}>返回站点</a>
    </section>
  )}
</KeywordLayout>
