---
import Layout from '../../../layouts/Layout.astro';
import { SITE, pathFor, getTemplate } from '../../../lib/site';
const lang = 'en' as const;
const t = getTemplate('bby-wow');
const { oneShotUsd, creditPerGenerate, packs } = SITE.pricing;
---
<Layout
  title={`Create ${t.nameEn} — ${SITE.name}`}
  description="Upload one adult-consent photo and generate a ~10s vertical party-dance video. Credits visible. FAL stub until configured."
  canonicalPath="/create/bby-wow/"
  lang={lang}
>
  <div class="page-head wrap">
    <h1>Create — {t.nameEn}</h1>
    <p>1 photo → {t.durationEn} vertical party-dance. Costs {creditPerGenerate} credit · one-shot from ${oneShotUsd}.</p>
  </div>

  <section class="section wrap">
    <div class="callout warn">
      <strong>Adult consent only.</strong> Do not upload photos of minors, strangers, or anyone who did not agree.
      Not affiliated with Karol G or CapCut. No song license — AI motion remix only.
    </div>

    <div class="credits-bar">
      <div>
        <strong>Credits:</strong> <span id="credit-count">0</span>
        <span class="badge" style="margin-left:0.5rem">demo balance</span>
      </div>
      <div>
        Price: <strong>1 credit</strong> / generate · packs from ${packs[0].usd}
        · <a href={pathFor(lang, '/pricing/')}>Buy credits</a>
      </div>
    </div>

    <div class="studio" style="margin-top:1.25rem">
      <div>
        <label class="upload-zone" for="photo-input">
          <input id="photo-input" type="file" accept="image/jpeg,image/png,image/webp" />
          <div id="upload-placeholder">
            <strong>Drop photo or click to upload</strong>
            <div class="hint">JPG / PNG / WebP · clear face or full body · you must own rights</div>
          </div>
          <img id="preview" class="preview-img" alt="Preview" hidden />
        </label>
        <label style="display:flex;gap:0.5rem;align-items:flex-start;margin-top:1rem;font-size:0.92rem;color:var(--secondary)">
          <input id="consent" type="checkbox" style="margin-top:0.25rem" />
          <span>I confirm this photo shows an adult (18+) who consented, and I have rights to use it.</span>
        </label>
      </div>

      <div class="card">
        <h3>Generate</h3>
        <p style="margin-bottom:1rem">Output: vertical 9:16 · {t.durationEn} · AI party-dance remix.</p>
        <button class="btn btn-primary" id="generate-btn" type="button" style="width:100%">Generate video</button>
        <div class="status-box cfg" id="status">Waiting for photo + consent…
Configure FAL_KEY / FAL_MODEL to render for real. Create UI is fully demoable without a key.</div>
        <p style="margin-top:1rem;font-size:0.88rem;color:var(--muted)">
          If generation fails after debit, we refund the credit (see <a href={pathFor(lang, '/faq/')}>FAQ</a> / Terms).
          Waffo checkout is stubbed until <code>WAFFO_*</code> is set.
        </p>
        <p style="margin-top:0.75rem;font-size:0.88rem;"><a href={pathFor(lang, '/')}>← All templates</a></p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const input = document.getElementById('photo-input');
      const preview = document.getElementById('preview');
      const placeholder = document.getElementById('upload-placeholder');
      const consent = document.getElementById('consent');
      const btn = document.getElementById('generate-btn');
      const status = document.getElementById('status');
      let hasFile = false;
      function setStatus(text, kind) {
        status.textContent = text;
        status.className = 'status-box' + (kind ? ' ' + kind : '');
      }
      input.addEventListener('change', function () {
        const file = input.files && input.files[0];
        if (!file) return;
        hasFile = true;
        preview.src = URL.createObjectURL(file);
        preview.hidden = false;
        placeholder.hidden = true;
        setStatus('Photo ready. Check adult consent, then Generate.\nFAL not configured — UI demo mode.', 'cfg');
      });
      btn.addEventListener('click', function () {
        if (!hasFile) { setStatus('Upload one photo first.', 'err'); return; }
        if (!consent.checked) { setStatus('Confirm adult consent before generating.', 'err'); return; }
        setStatus('Demo queue… job_demo_bbywow_' + Date.now() + '\nNo FAL_KEY — simulated success in ~2s.', 'cfg');
        setTimeout(function () {
          setStatus('Demo complete. Wire FAL_KEY + FAL_MODEL on Cloudflare Pages for real renders.\nCredit would debit 1 (refunded on provider failure).', 'ok');
        }, 1800);
      });
    })();
  </script>
</Layout>
