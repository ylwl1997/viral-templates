---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../lib/site';
import PricingGrid from '../../design/components/PricingGrid.astro';

const { packs, oneShotUsd, kissCamOneShotUsd } = SITE.pricing;
---
<Layout
  title="Pricing (stub)"
  description="Placeholder pricing for Viral Templates AI video products."
  canonicalPath="/pricing/"
  lang="en"
>
  <div class="page-head wrap"><h1>Pricing (stub)</h1><p>Checkout is not connected. Numbers are placeholders.</p></div>
  <section class="section wrap">
    <PricingGrid
      oneShotLabel="One-shot"
      oneShotUsd={oneShotUsd}
      oneShotMeta={`Kiss Cam from $${kissCamOneShotUsd} · stub`}
      packs={packs}
      stubNote="Pay on Create shows a clear stub — no fake success."
    />
  </section>
</Layout>
