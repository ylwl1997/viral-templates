---
import Layout from '../../layouts/Layout.astro';
import Accordion from '../../design/components/Accordion.astro';
---
<Layout
  title="FAQ"
  description="Frequently asked questions about Viral Templates AI video products."
  canonicalPath="/faq/"
  lang="en"
>
  <div class="page-head wrap"><h1>FAQ</h1><p>Common questions about photos, consent, refunds, and CapCut.</p></div>
  <section class="section wrap">
    <Accordion
      items={[
        { q: 'What photos can I upload?', a: 'Clear, well-lit adult-consent photos work best. One or two photos depending on the template. Do not upload photos of minors.' },
        { q: 'Do I need consent?', a: 'Yes. Only adults who agree to appear in an AI remix. Kiss Cam uses no real concert footage. Ceiling Fan is AI only — never strap a phone to a fan.' },
        { q: 'Is generate available yet?', a: 'Not yet. Generate and Pay show Coming soon until those features are ready. No fake success videos.' },
        { q: 'Refunds?', a: 'Checkout is not open on this demo. When payments go live, refund rules will be stated on the Terms page.' },
        { q: 'Are you CapCut / Coldplay / Karol G?', a: 'No. Independent AI remix tools — not official CapCut, Coldplay, Karol G, or any label.' },
        { q: 'Photo retention?', a: 'About 30 days after upload/job — see Privacy.' },
      ]}
    />
  </section>
</Layout>
