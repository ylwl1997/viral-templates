{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template-pack.schema.json",
  "title": "Template pack 1.0.0",
  "type": "object",
  "required": ["schemaVersion", "id", "aspectRatio", "sourceDurationSec", "roles", "generationSegments", "providerHints"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "aspectRatio": { "const": "9:16" },
    "sourceDurationSec": { "type": "number", "exclusiveMinimum": 0 },
    "generationSegments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "startSec", "endSec", "durationSec", "promptSeconds", "variantPrompts"],
        "properties": {
          "promptSeconds": { "type": "integer", "minimum": 4, "maximum": 12 },
          "variantPrompts": {
            "type": "object",
            "required": ["timed-beats", "locked-segment"]
          }
        }
      }
    },
    "providerHints": {
      "type": "object",
      "required": ["defaultModel", "resolution", "imagesOnly", "mode"],
      "properties": {
        "defaultModel": { "const": "agnes-video-2.5" },
        "resolution": { "const": "720P" },
        "imagesOnly": { "const": true },
        "mode": { "const": "reference" }
      }
    }
  }
}
