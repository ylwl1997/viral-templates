---
import Layout from '../../../layouts/Layout.astro';
import { SITE } from '../../../lib/site';
const lang = 'zh' as const;
---
<Layout
  title={`价格 — ${SITE.name}`}
  description="积分与一次性购买。Waffo 为 stub。"
  canonicalPath="/pricing/"
  lang={lang}
>
  <div class="page-head wrap">
    <h1>价格</h1>
    <p>积分与一次性购买。Waffo 为 stub。</p>
  </div>

  <section class="section wrap">
    <div class="pricing-grid">
      <div class="price-card"><h3>一次性（1 图模板）</h3><div class="amount">$2.99</div></div>
      <div class="price-card"><h3>Kiss Cam</h3><div class="amount">$4.99</div></div>
      <div class="price-card popular"><h3>Creator 包</h3><div class="amount">$24.99</div><div class="meta">15 积分</div></div>
    </div>
    <p style="margin-top:1.5rem"><a href="/pricing/">完整英文定价页</a></p>
  </section>
</Layout>
